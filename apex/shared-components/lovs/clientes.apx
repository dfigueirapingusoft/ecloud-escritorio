lov clientes (
    name: CLIENTES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select razao_social || ' (' || pkg_ecloud_util.formatar_cnpj(cnpj) || ')' d, cliente_id r
              from cliente
             where ativo = 'S'
             order by razao_social
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

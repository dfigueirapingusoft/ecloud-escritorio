appProcess anuncio-evento (
    name: ANUNCIO_EVENTO
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            -- Exibição ou clique de anúncio vindo do carrossel (anuncios.js):
            -- x01 = id do anúncio, x02 = EXIBICAO ou CLIQUE. Público, porque a
            -- vitrine aparece na tela de login. O pacote grava em transação
            -- autônoma e ignora id inválido; a resposta é só um "ok".
            pkg_ecloud_anuncio.registrar_evento(
                p_anuncio_id => to_number(apex_application.g_x01 default null on conversion error),
                p_evento     => substr(apex_application.g_x02, 1, 20));
            htp.p('ok');
            ```
    }
    execution {
        sequence: 10
        point: ajaxCallback
    }
    comments {
        comments: Contagem de exibições e cliques dos anúncios (tela de login e Ofertas e parceiros).
    }
)

appProcess acesso-assinatura (
    name: ACESSO_ASSINATURA
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            -- Antes de cada página do usuário logado:
            -- * senha marcada para troca -> Trocar senha (113);
            -- * escritório SUSPENSO -> só Minha assinatura (106) e Trocar senha.
            -- O administrador da plataforma nunca é bloqueado. Páginas públicas
            -- (login, cadastro, esqueci e redefinir a senha) ficam de fora.
            if :APP_PAGE_ID not in (106, 110, 111, 112, 113, 9999)
               and pkg_ecloud_ctx.usuario_id is not null then
                if pkg_ecloud_auth.precisa_trocar_senha then
                    apex_util.redirect_url(apex_page.get_url(p_page => 113));
                elsif pkg_ecloud_assinatura.esta_suspenso and not pkg_ecloud_ctx.is_admin_plataforma then
                    apex_util.redirect_url(apex_page.get_url(p_page => 106));
                end if;
            end if;
            ```
    }
    execution {
        sequence: 20
        point: beforeHeader
    }
    serverSideCondition {
        type: userIsAuthenticated
    }
    comments {
        comments: Bloqueio do escritório suspenso e troca obrigatória de senha (docs/07-autocadastro-assinatura.md).
    }
)

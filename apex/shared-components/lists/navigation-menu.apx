list navigation-menu (
    name: Navigation Menu

    entry painel (
        label: Painel
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry simulacoes (
        label: Simulações
        icon {
            imageIconCssClasses: fa-calculator
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: [
                30
                31
                32
            ]
        }
        link {
            target: {
                page: 30
            }
        }
    )

    entry danfse (
        label: DANFSe
        icon {
            imageIconCssClasses: fa-file-pdf-o
        }
        layout {

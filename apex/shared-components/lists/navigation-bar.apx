list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry meu-depoimento (
        label: Meu depoimento
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 15
            parentEntry: @app-user
        }
        link {
            target: {
                page: 104
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry minha-assinatura (
        label: Minha assinatura
        icon {
            imageIconCssClasses: fa-credit-card
        }
        layout {
            sequence: 16
            parentEntry: @app-user
        }
        link {
            target: {
                page: 106
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry trocar-senha (
        label: Trocar senha
        icon {
            imageIconCssClasses: fa-key
        }
        layout {
            sequence: 17
            parentEntry: @app-user
        }
        link {
            target: {
                page: 113
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sair
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)


page 43 (
    name: Emitentes de NFS-e
    alias: EMITENTES-NFSE
    title: Emitentes de NFS-e
    pageGroup: @nfsen
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region emitentes (
        name: Emitentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Prestadores que emitem NFS-e Nacional pela Focus NFe: o próprio escritório e
                -- clientes em nome de quem o escritório emite (docs/09-nfse-nacional-focus.md).
                select e.emitente_id,
                       e.tipo,
                       pkg_rural_cadastro.formatar_documento(coalesce(e.cnpj, e.cpf)) as documento,
                       e.razao_social,
                       e.ambiente,
                       e.focus_situacao,
                       case e.ambiente when 'PRODUCAO' then e.token_prod else e.token_hom end as token_ambiente,
                       cast(e.certificado_valido_ate as date) as certificado_valido_ate,
                       e.serie_dps,
                       e.proximo_numero_dps,
                       e.ativo
                  from nfsen_emitente e
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 44
                items: {
                    P44_EMITENTE_ID: \#EMITENTE_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Abrir"><span class="fa fa-edit" aria-hidden="true" title="Abrir"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        actionsMenu {
            subscription: false
        }

        column EMITENTE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
        )

        column TIPO (
            type: plainTextBasedOnLov
            heading {
                heading: Prestador
            }
            lov {
                lov: @tipo-emitente-nfsen
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
        )

        column DOCUMENTO (
            type: plainText
            heading {
                heading: CPF/CNPJ
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
        )

        column RAZAO_SOCIAL (
            type: plainText
            heading {
                heading: Razão social
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
        )

        column AMBIENTE (
            type: plainTextBasedOnLov
            heading {
                heading: Ambiente
            }
            lov {
                lov: @ambiente-nfsen
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
        )

        column FOCUS_SITUACAO (
            type: plainTextBasedOnLov
            heading {
                heading: Cadastro na Focus
            }
            lov {
                lov: @situacao-focus
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
        )

        column TOKEN_AMBIENTE (
            type: plainTextBasedOnLov
            heading {
                heading: Token no ambiente
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
        )

        column CERTIFICADO_VALIDO_ATE (
            type: plainText
            heading {
                heading: Certificado válido até
            }
            layout {
                sequence: 8
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
            source {
                dataType: date
            }
        )

        column SERIE_DPS (
            type: plainText
            heading {
                heading: Série DPS
            }
            layout {
                sequence: 9
            }
            source {
                dataType: number
            }
        )

        column PROXIMO_NUMERO_DPS (
            type: plainText
            heading {
                heading: Próximo nº DPS
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
        )

        column ATIVO (
            type: plainTextBasedOnLov
            heading {
                heading: Ativo
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
        )

        savedReport 5845983902 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn TIPO (
                sequence: 1
            )

            displayColumn DOCUMENTO (
                sequence: 2
            )

            displayColumn RAZAO_SOCIAL (
                sequence: 3
            )

            displayColumn AMBIENTE (
                sequence: 4
            )

            displayColumn FOCUS_SITUACAO (
                sequence: 5
            )

            displayColumn TOKEN_AMBIENTE (
                sequence: 6
            )

            displayColumn CERTIFICADO_VALIDO_ATE (
                sequence: 7
            )

            displayColumn SERIE_DPS (
                sequence: 8
            )

            displayColumn PROXIMO_NUMERO_DPS (
                sequence: 9
            )

            displayColumn ATIVO (
                sequence: 10
            )

            sort (
                column: RAZAO_SOCIAL
                sort {
                    sequence: 1
                }
            )

        )
    )

    region webhook (
        name: Webhook da Focus
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- URL única da conta da plataforma para cadastrar à mão no painel da Focus
                -- (gatilho nfsen de cada empresa). Leva o token do webhook: só o admin da plataforma vê.
                return '<p>Cadastre esta URL no painel da Focus, no gatilho <strong>nfsen</strong> de cada empresa:</p>'
                    || '<p><code>' || apex_escape.html(pkg_nfsen.url_webhook) || '</code></p>'
                    || '<p>O aviso só dispara a releitura da nota. Sem ele, o job consulta as notas em processamento.</p>';
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @admin-plataforma
        }
    )

    button create (
        buttonName: CREATE
        label: Novo emitente
        layout {
            sequence: 10
            region: @emitentes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 44
                clearCache: 44
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @administrador
        }
    )

)

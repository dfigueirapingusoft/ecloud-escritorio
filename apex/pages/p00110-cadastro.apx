            sequence: 30
            region: @escritorio
            slot: regionBody
            columnSpan: 8
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs

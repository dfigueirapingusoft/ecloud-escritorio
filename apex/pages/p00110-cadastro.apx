            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            maxLength: 20
        }
    )

    pageItem P110_CEP (
        type: textField
        label {
            label: CEP
            alignment: right
        }
        layout {
            sequence: 50
            region: @escritorio
            slot: regionBody
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            maxLength: 10
        }
        help {
            inlineHelpText: Digite o CEP para preencher o endereço.
        }

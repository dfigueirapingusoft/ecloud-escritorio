page 110 (
    name: Cadastre seu escritório
    alias: CADASTRO
    title: Ecloud - Cadastre seu escritório
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
        cssClasses: ec-cadastro-stage
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #APP_FILES#cep.js
    }
    security {
        authentication: public
    }

    region topo (
        name: Topo
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ec-auth-brand ec-cadastro-brand">
                    <h1 class="ec-auth-title"><span class="ec-logo ec-logo--auth" role="img" aria-label="Ecloud - Escritório Cloud"></span></h1>
                    <p class="ec-auth-subtitle">Cadastre seu escritório e use o Ecloud grátis durante o período de teste, sem cartão.</p>
                    <p class="ec-auth-subtitle"><a class="ec-auth-link" href="f?p=&APP_ID.:LOGIN:&APP_SESSION.">Já tenho conta: entrar</a></p>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region escritorio (
        name: Escritório
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P110_CHAVE
        }
    )

    region responsavel (
        name: Seu acesso
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P110_CHAVE
        }
    )

    region plano (
        name: Plano depois do teste
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P110_CHAVE
        }
    )

    region codigo (
        name: Confirme o seu contato
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Enviamos um código de 6 dígitos para <strong>&P110_DESTINO.</strong>. Ele vale por 10 minutos.</p>
                <p class="ec-auth-subtitle">Não chegou? Confira a caixa de spam ou peça outro código. A conta só é criada depois do código certo.</p>
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P110_CHAVE
        }
    )

    pageItem P110_CHAVE (
        type: hidden
        layout {
            sequence: 5
            region: @topo
            slot: regionBody
        }
    )

    pageItem P110_DESTINO (
        type: hidden
        layout {
            sequence: 6
            region: @topo
            slot: regionBody
        }
        source {
            used: always
            type: expression
            language: plsql
            plsqlExpression: case when :P110_CHAVE is not null then pkg_ecloud_verificacao.destino_mascarado(:P110_CHAVE) end
        }
    )

    pageItem P110_CNPJ (
        type: textField
        label {
            label: CNPJ
            alignment: right
        }
        layout {
            sequence: 10
            region: @escritorio
            slot: regionBody
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
            maxLength: 18
        }
        help {
            inlineHelpText: Aceita o CNPJ numérico e o novo alfanumérico.
        }
    )

    pageItem P110_RAZAO_SOCIAL (
        type: textField
        label {
            label: Razão social
            alignment: right
        }
        layout {
            sequence: 20
            region: @escritorio
            slot: regionBody
            startNewRow: false
            columnSpan: 8
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
    )

    pageItem P110_NOME_FANTASIA (
        type: textField
        label {

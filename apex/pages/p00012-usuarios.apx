page 12 (
    name: Usuários
    alias: USUARIOS
    title: Usuários
    pageGroup: @administracao
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @administrador
    }
    help {
        helpText:
            ```html
            <p>O login usa as contas do Oracle APEX do workspace. Cadastre aqui o mesmo nome de usuário
            da conta APEX para ligar a pessoa ao escritório e ao perfil.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region usuarios (
        name: Usuários
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario_id,
                       u.username,
                       u.nome,
                       u.email,
                       u.perfil,
                       u.admin_plataforma,
                       u.ativo,
                       cast(u.ultimo_acesso_em as date) as ultimo_acesso_em
                  from usuario u
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 13
                items: {
                    P13_USUARIO_ID: \#USUARIO_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        actionsMenu {
            subscription: false
        }

        column USUARIO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Usuário
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: E-mail
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
        )

        column PERFIL (
            type: plainTextBasedOnLov
            heading {
                heading: Perfil
            }
            lov {
                lov: @perfis
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
        )

        column ADMIN_PLATAFORMA (
            type: plainTextBasedOnLov
            heading {
                heading: Admin. plataforma
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
        )

        column ATIVO (
            type: plainTextBasedOnLov
            heading {
                heading: Ativo
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
        )

        column ULTIMO_ACESSO_EM (
            type: plainText
            heading {
                heading: Último acesso
            }
            layout {
                sequence: 8
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
            source {
                dataType: date
            }
        )

        savedReport 417178190 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn USERNAME (
                sequence: 1
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn EMAIL (
                sequence: 3
            )

            displayColumn PERFIL (
                sequence: 4
            )

            displayColumn ADMIN_PLATAFORMA (
                sequence: 5
            )

            displayColumn ATIVO (
                sequence: 6
            )

            displayColumn ULTIMO_ACESSO_EM (
                sequence: 7
            )

            sort (
                column: NOME
                sort {
                    sequence: 1
                }
            )

        )
    )

    button create (
        buttonName: CREATE
        label: Criar usuário
        layout {
            sequence: 10
            region: @usuarios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                clearCache: 13
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-after-dialog (
        name: Atualizar após fechar o diálogo
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @usuarios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @usuarios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

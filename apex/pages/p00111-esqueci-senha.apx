page 111 (
    name: Esqueci a senha
    alias: ESQUECI-SENHA
    title: Ecloud - Esqueci a senha
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
    }

    region esqueci (
        name: Esqueci a senha
        type: staticContent
        source {
            htmlCode:
                ```html
                <p class="ec-auth-subtitle">Informe o e-mail do seu usuário. Se ele estiver cadastrado, você recebe um link para criar uma nova senha.</p>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
    )

    pageItem P111_EMAIL (
        type: textField
        label {
            label: E-mail
            alignment: right
        }
        layout {
            sequence: 10
            region: @esqueci
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-envelope-o
            valuePlaceholder: E-mail
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        advanced {
            customAttributes: autocomplete="email"
        }
        sessionState {
            storage: request
        }
    )

    button enviar (
        buttonName: ENVIAR
        label: Enviar o link
        layout {
            sequence: 10
            region: @esqueci
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar para a entrada
        layout {
            sequence: 20
            region: @esqueci
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--link
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process enviar (
        name: Enviar link de redefinição
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- A mensagem é a mesma exista ou não o e-mail (não revela quem tem conta).
                pkg_ecloud_cadastro.enviar_redefinicao(
                    p_email => :P111_EMAIL,
                    p_ip    => owa_util.get_cgi_env('REMOTE_ADDR'));
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1111100001
        }
        successMessage {
            successMessage: Se o e-mail estiver cadastrado, o link chega em alguns minutos. Confira também a caixa de spam.
        }
        serverSideCondition {
            whenButtonPressed: @enviar
        }
    )

    branch entrada (
        name: Voltar para a entrada
        execution {
            sequence: 10
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 9999
            }
        }
        serverSideCondition {
            whenButtonPressed: @enviar
        }
    )

)

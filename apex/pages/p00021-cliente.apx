page 21 (
    name: Cliente
    alias: CLIENTE
    title: Cliente
    pageGroup: @cadastros
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    javaScript {
        fileUrls: #APP_FILES#cep.js
        functionAndGlobalVariableDeclaration:
            ```javascript
            // Campos de pessoa física (F) ou jurídica (J). Os escondidos são limpos
            // no servidor (processo "Guardar só o documento do tipo de pessoa").
            var ecCliente = {
                soPJ: ["P21_CNPJ", "P21_NOME_FANTASIA", "P21_CRT"],
                soPF: ["P21_CPF", "P21_CAEPF", "P21_FORMA_APURACAO_RURAL"],
                aplicarTipo: function () {
                    var pf = apex.item("P21_TIPO_PESSOA").getValue() === "F";
                    ecCliente.soPJ.forEach(function (i) { pf ? apex.item(i).hide() : apex.item(i).show(); });
                    ecCliente.soPF.forEach(function (i) { pf ? apex.item(i).show() : apex.item(i).hide(); });
                    apex.jQuery("#P21_RAZAO_SOCIAL_LABEL").text(pf ? "Nome completo" : "Razão social");
                }
            };
            ```
        executeWhenPageLoads:
            ```javascript
            ecCliente.aplicarTipo();
            apex.jQuery("#P21_TIPO_PESSOA").on("change", ecCliente.aplicarTipo);
            ```
    }

    region buttons (
        name: Botões
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region cliente (
        name: Cliente
        type: form
        source {
            location: localDatabase
            tableName: CLIENTE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P21_CLIENTE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @cliente
            slot: regionBody
        }
        source {
            formRegion: @cliente
            column: CLIENTE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )


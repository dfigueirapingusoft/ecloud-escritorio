    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_CLIENTE_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_CLIENTE_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P21_CLIENTE_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    validation documento-obrigatorio (
        name: Documento conforme o tipo de pessoa
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return (:P21_TIPO_PESSOA = 'J' and :P21_CNPJ is not null)
                    or (:P21_TIPO_PESSOA = 'F' and :P21_CPF is not null);
                ```
        }
        error {
            errorMessage: Informe o CNPJ (pessoa jurídica) ou o CPF (pessoa física).
            associatedItem: @P21_CNPJ
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation cpf-valido (
        name: CPF válido
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return :P21_TIPO_PESSOA = 'J' or :P21_CPF is null or pkg_rural_cadastro.cpf_valido(:P21_CPF);
        }
        error {
            errorMessage: CPF inválido: confira os dígitos verificadores.
            associatedItem: @P21_CPF
        }
        execution {
            sequence: 15
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation regime-pf (
        name: Não contribuinte só para pessoa física
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return :P21_REGIME <> 'NAO_CONTRIBUINTE' or :P21_TIPO_PESSOA = 'F';
        }
        error {
            errorMessage: O regime "Produtor rural não contribuinte" é só para pessoa física.
            associatedItem: @P21_REGIME
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation cnpj-valido (
        name: CNPJ válido
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return :P21_TIPO_PESSOA = 'F' or :P21_CNPJ is null or pkg_ecloud_util.cnpj_valido(:P21_CNPJ);
                ```
        }
        error {
            errorMessage: CNPJ inválido: confira os dígitos verificadores.
            associatedItem: @P21_CNPJ
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation municipio-da-uf (
        name: Município pertence à UF
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return pkg_ecloud_util.municipio_valido(:P21_UF, to_number(:P21_MUNICIPIO_IBGE));
                ```
        }
        error {
            errorMessage: O município informado não pertence à UF.
            associatedItem: @P21_MUNICIPIO_IBGE
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancelar diálogo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @cliente
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4066995115
        }
    )

    process limpar-documento (
        name: Guardar só o documento do tipo de pessoa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- CNPJ para pessoa jurídica, CPF para pessoa física (constraint CLIENTE_DOCUMENTO_CK).
                -- Campos só de PJ (nome fantasia, CRT) ficam vazios para pessoa física.
                if :P21_TIPO_PESSOA = 'F' then
                    :P21_CNPJ := null;
                    :P21_NOME_FANTASIA := null;
                    :P21_CRT := null;
                else
                    :P21_CPF := null;
                    :P21_CAEPF := null;
                end if;
                ```
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 6453414852
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process process-form (
        name: Gravar formulário
        type: formAutoRowProcessing
        formRegion: @cliente
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3464554397
        }
    )

    process close-dialog (
        name: Fechar diálogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 4698360966
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)

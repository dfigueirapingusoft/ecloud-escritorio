    dynamicAction trocar-filtro (
        name: Recarregar ao trocar o filtro
        execution {
            sequence: 50
        }
        when {
            event: change
            selectionType: items
            items: P85_CLIENTE_ID
        }
        action native-submit (
            action: submitPage
            settings {
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process carregar-produtor (
        name: Carregar o produtor escolhido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- O produtor escolhido em qualquer página do módulo fica em F_PRODUTOR_ID.
                if :F_PRODUTOR_ID is not null then
                    if :P85_CLIENTE_ID is null or :P85_CLIENTE_ID <> :F_PRODUTOR_ID then
                        :P85_CONTA_ID := null;
                    end if;
                    :P85_CLIENTE_ID := :F_PRODUTOR_ID;
                end if;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2356172113
        }
    )

    process guardar-produtor (
        name: Guardar o produtor escolhido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :F_PRODUTOR_ID is null or :F_PRODUTOR_ID <> :P85_CLIENTE_ID then
                    :P85_CONTA_ID := null;
                end if;
                :F_PRODUTOR_ID := :P85_CLIENTE_ID;
                ```
        }
        execution {
            sequence: 1
        }
        advanced {
            executionMappingIdentifier: 6400647576
        }
    )

    process automatico (
        name: Conciliar automaticamente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_qtd number;
                begin
                    -- Concilia só os pares sem ambiguidade (valor exato, data em até 3 dias)
                    -- e depois aplica as regras de conciliação aos movimentos que sobraram.
                    l_qtd := pkg_conciliacao.conciliar_automatico(
                                 p_conta_id    => :P85_CONTA_ID,
                                 p_data_inicio => to_date(:P85_DATA_INICIO, 'DD/MM/YYYY'),
                                 p_data_fim    => to_date(:P85_DATA_FIM, 'DD/MM/YYYY'));
                    apex_application.g_print_success_message := l_qtd || ' movimento(s) conciliado(s).';
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 9175712717
        }
        serverSideCondition {
            whenButtonPressed: @automatico
        }
    )

    branch recarregar (
        name: Recarregar a página
        execution {
            sequence: 99
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 85
            }
        }
    )
)

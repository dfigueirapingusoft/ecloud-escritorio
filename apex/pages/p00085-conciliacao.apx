            layout {
                sequence: 2
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
        )
        column VALOR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Valor
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column SALDO_ABERTO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Em aberto
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {

    region conciliacoes (
        name: Conciliados no período
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                     select i.item_id,
                            i.data_movimento,
                            i.historico as historico_extrato,
                            c.valor,
                            c.tipo,
                            l.data_lancamento,
                            l.historico as historico_livro,
                            cast(c.criado_em as date) as conciliado_em,
                            c.criado_por
                       from conciliacao c
                       join extrato_item i
                         on i.item_id = c.item_id
                       join livro_caixa l
                         on l.lancamento_id = c.lancamento_id
                      where i.conta_id = :P85_CONTA_ID
                and i.data_movimento >= to_date(:P85_DATA_INICIO, 'DD/MM/YYYY')
                and i.data_movimento <  to_date(:P85_DATA_FIM, 'DD/MM/YYYY') + 1
                      order by i.data_movimento, c.conciliacao_id
                ```
            pageItemsToSubmit: P85_CLIENTE_ID,P85_CONTA_ID,P85_DATA_INICIO,P85_DATA_FIM
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nada conciliado no período.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P85_CONTA_ID
        }
        column ITEM_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Ver
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 86
                    items: {
                        P86_ITEM_ID: \#ITEM_ID#\
                    }
                }
                linkText: <span class="fa fa-search" aria-hidden="true" title="Ver ou desfazer"></span><span class="u-VisuallyHidden">Ver</span>
            }
            sorting {
                sortable: false
            }
        )
        column DATA_MOVIMENTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data no extrato
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
        )
        column HISTORICO_EXTRATO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Histórico do extrato
            }
            layout {
                sequence: 3
            }
        )
        column VALOR (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor conciliado
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column TIPO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Tipo
            }
            layout {
                sequence: 5
            }
        )
        column DATA_LANCAMENTO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data no livro
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
        )
        column HISTORICO_LIVRO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Histórico do livro
            }
            layout {
                sequence: 7
            }
        )
        column CONCILIADO_EM (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Conciliado em
            }
            layout {
                sequence: 8
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
        )
        column CRIADO_POR (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Por
            }
            layout {
                sequence: 9
            }
        )
    )

    button automatico (
        buttonName: AUTOMATICO
        label: Conciliar automaticamente
        layout {
            sequence: 10
            region: @acoes
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            icon: fa-magic
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    dynamicAction refresh-sugestoes (
        name: Atualizar após fechar o diálogo
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sugestoes
        }
        action refresh-situacao (
            action: refresh
            affectedElements {
                selectionType: region
                region: @situacao
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-sugestoes (
            action: refresh
            affectedElements {
                selectionType: region

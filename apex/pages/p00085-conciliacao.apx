        )
        column MOTIVO (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Motivo
            }
            layout {
                sequence: 10
            }
        )
    )

    region itens (
        name: Extrato a conciliar
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                     select i.item_id,
                            i.data_movimento,
                            i.valor,
                            pkg_conciliacao.saldo_aberto_item(i.item_id) as saldo_aberto,
                            i.historico,
                            i.documento,
                            i.tipo_transacao
                       from extrato_item i
                      where i.conta_id = :P85_CONTA_ID
                        and i.status = 'PENDENTE'
                and i.data_movimento >= to_date(:P85_DATA_INICIO, 'DD/MM/YYYY')
                and i.data_movimento <  to_date(:P85_DATA_FIM, 'DD/MM/YYYY') + 1
                      order by i.data_movimento, i.item_id
                ```
            pageItemsToSubmit: P85_CLIENTE_ID,P85_CONTA_ID,P85_DATA_INICIO,P85_DATA_FIM
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nada pendente no extrato.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P85_CONTA_ID
        }
        column ITEM_ID (

page 85 (
    name: Conciliação bancária
    alias: CONCILIACAO
    title: Conciliação bancária
    pageGroup: @rural
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <p>Escolha a conta e o período. A conciliação automática só junta pares sem ambiguidade; o resto aparece como sugestão ou fica para tratar um a um: conciliar com um lançamento, lançar no livro caixa ou ignorar.</p>
            ```
    }
    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
        }
    )

    pageItem P85_CLIENTE_ID (
        type: selectList
        label {
            label: Produtor rural
            alignment: right
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            columnSpan: 5
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @produtores
            displayNullValue: true
            nullDisplayValue: - Selecione o produtor -
        }
        sessionState {
            storage: session
        }
    )

    pageItem P85_CONTA_ID (
        type: selectList
        label {
            label: Conta
            alignment: right
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select lpad(cod_conta, 3, '0') || ' - ' || apelido d, conta_id r
                  from conta_bancaria
                 where cliente_id = :P85_CLIENTE_ID
                   and ativo = 'S'
                   and tipo <> 'CAIXA'
                 order by cod_conta
                ```
            displayNullValue: true
            nullDisplayValue: - Selecione -
        }
        sessionState {
            storage: session
        }
        cascadingLov {
            parentItems: P85_CLIENTE_ID
        }
    )

    pageItem P85_DATA_INICIO (
        type: datePicker
        label {
            label: De
            alignment: right
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: add_months(trunc(current_date, 'MM'), -1)
        }
        sessionState {
            storage: session
        }
    )

    pageItem P85_DATA_FIM (
        type: datePicker
        label {
            label: Até
            alignment: right
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: trunc(current_date)
        }
        sessionState {
            storage: session
        }
    )

    button aplicar (
        buttonName: APLICAR
        label: Aplicar filtros
        layout {
            sequence: 10
            region: @filtros
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    region sem-produtor (
        name: Selecione o produtor
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Selecione o produtor rural para ver os dados. Produtores são clientes pessoa física, cadastrados em Clientes.</p>
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P85_CLIENTE_ID
        }
    )

    region acoes (
        name: Ações
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P85_CONTA_ID
        }
    )

    region sem-conta (
        name: Escolha a conta
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Escolha a conta bancária e o período e clique em <strong>Aplicar filtros</strong>. Extratos são importados em Extratos bancários.</p>
                ```
        }
        layout {
            sequence: 16
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :P85_CLIENTE_ID is not null and :P85_CONTA_ID is null
        }
    )

    region situacao (
        name: Situação da conta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.saldo_livro,
                       v.saldo_banco,
                       v.data_saldo_banco,
                       v.saldo_livro_data_banco,
                       v.saldo_banco - v.saldo_livro_data_banco as diferenca,
                       v.itens_extrato_pendentes,
                       v.lancamentos_pendentes,
                       v.ultimo_movimento_extrato
                  from vw_conta_conciliacao v
                 where v.conta_id = :P85_CONTA_ID
                ```
            pageItemsToSubmit: P85_CLIENTE_ID,P85_CONTA_ID,P85_DATA_INICIO,P85_DATA_FIM
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nenhum registro.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P85_CONTA_ID
        }
        column SALDO_LIVRO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Saldo no livro (hoje)
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column SALDO_BANCO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Último saldo do banco
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column DATA_SALDO_BANCO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data do saldo do banco
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
        )
        column SALDO_LIVRO_DATA_BANCO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Saldo no livro nessa data
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column DIFERENCA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Diferença a conciliar
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column ITENS_EXTRATO_PENDENTES (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Extrato pendente
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
        )
        column LANCAMENTOS_PENDENTES (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Livro pendente
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
        )
        column ULTIMO_MOVIMENTO_EXTRATO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Último movimento do extrato
            }
            layout {
                sequence: 8
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
        )
    )

    region sugestoes (
        name: Sugestões de conciliação
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.item_id,
                       s.lancamento_id,
                       i.data_movimento,
                       i.valor as valor_extrato,
                       i.historico as historico_extrato,
                       l.data_lancamento,
                       l.valor as valor_livro,
                       l.historico as historico_livro,
                       s.pontuacao,
                       s.motivo
                  from table(pkg_conciliacao.sugerir(:P85_CONTA_ID,
                                                     to_date(:P85_DATA_INICIO, 'DD/MM/YYYY'),
                                                     to_date(:P85_DATA_FIM, 'DD/MM/YYYY'))) s
                  join extrato_item i
                    on i.item_id = s.item_id
                  join livro_caixa l
                    on l.lancamento_id = s.lancamento_id
                 order by i.data_movimento, s.pontuacao desc
                ```
            pageItemsToSubmit: P85_CLIENTE_ID,P85_CONTA_ID,P85_DATA_INICIO,P85_DATA_FIM
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nenhuma sugestão no período.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P85_CONTA_ID
        }
        column ITEM_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Conciliar
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 86
                    items: {
                        P86_ITEM_ID: \#ITEM_ID#\
                        P86_LANCAMENTO_ID: \#LANCAMENTO_ID#\
                    }
                }
                linkText: <span class="fa fa-link" aria-hidden="true" title="Conciliar"></span><span class="u-VisuallyHidden">Conciliar</span>
            }
            sorting {
                sortable: false
            }
        )
        column LANCAMENTO_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )
        column DATA_MOVIMENTO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data no extrato
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
        )
        column VALOR_EXTRATO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor no extrato
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column HISTORICO_EXTRATO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Histórico do extrato
            }
            layout {
                sequence: 5
            }
        )
        column DATA_LANCAMENTO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data no livro
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
        )
        column VALOR_LIVRO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor no livro
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column HISTORICO_LIVRO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Histórico do livro
            }
            layout {
                sequence: 8
            }
        )
        column PONTUACAO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Pontuação
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end

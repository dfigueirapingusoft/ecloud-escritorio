    region pendentes (
        name: Livro caixa a conciliar
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                     select l.lancamento_id,
                            l.data_lancamento,
                            case l.natureza when 'E' then l.valor else -l.valor end as valor,
                            pkg_conciliacao.saldo_aberto_lancamento(l.lancamento_id) as saldo_aberto,
                            l.historico,
                            c.codigo || ' - ' || c.nome as categoria
                       from livro_caixa l
                       join categoria_caixa c
                         on c.categoria_id = l.categoria_id
                      where l.conta_id = :P85_CONTA_ID
                        and l.status_conciliacao = 'PENDENTE'
                and l.data_lancamento >= to_date(:P85_DATA_INICIO, 'DD/MM/YYYY')
                and l.data_lancamento <  to_date(:P85_DATA_FIM, 'DD/MM/YYYY') + 1
                      order by l.data_lancamento, l.lancamento_id
                ```
            pageItemsToSubmit: P85_CLIENTE_ID,P85_CONTA_ID,P85_DATA_INICIO,P85_DATA_FIM
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {

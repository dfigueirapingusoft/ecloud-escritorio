page 9999 (
    name: Entrar
    alias: LOGIN
    title: Ecloud - Entrar
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
        cssClasses: ec-login-stage
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: [
            #APP_FILES#anuncios.js
            #APP_FILES#depoimentos.js
        ]
    }
    security {
        authentication: public
    }

    region ecloud (
        name: Ecloud - Escritório Cloud
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: [
                #DEFAULT#
                t-Login-region--headerHidden js-removeLandmark
            ]
        }
    )

    region marca (
        name: Marca
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ec-auth-brand">
                    <h1 class="ec-auth-title"><span class="ec-logo ec-logo--auth" role="img" aria-label="Ecloud - Escritório Cloud"></span></h1>
                    <p class="ec-auth-subtitle">Entre para continuar.</p>
                </div>
                ```
        }
        layout {
            sequence: 5
            parentRegion: @ecloud
            slot: regionBody
        }
    )

    region vitrine (
        name: Anúncios e depoimentos
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Lado esquerdo da tela: anúncios no ar em cima e depoimentos
                -- aprovados embaixo (db/06c_pacotes_body_vitrine.sql). Sem nenhum
                -- dos dois sobra só o cartão de login. Qualquer erro é registrado
                -- no debug e engolido: o login sempre abre.
                declare
                    l_anuncios    clob;
                    l_depoimentos clob;
                begin
                    begin
                        l_anuncios := pkg_ecloud_anuncio.login_html;
                    exception
                        when others then
                            apex_debug.error('Anúncios do login: %s', sqlerrm);
                    end;
                    begin
                        l_depoimentos := pkg_ecloud_depoimento.login_html;
                    exception
                        when others then
                            apex_debug.error('Depoimentos do login: %s', sqlerrm);
                    end;
                    if l_anuncios is null and l_depoimentos is null then
                        return null;
                    end if;
                    return '<div class="ec-showcase">' || l_anuncios || l_depoimentos || '</div>';
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P9999_PASSWORD (
        type: password
        label {
            label: Senha
            alignment: right
        }
        layout {
            sequence: 20
            region: @ecloud
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-key
            width: 40
            valuePlaceholder: Senha
        }
        validation {
            maxLength: 100
        }
        advanced {
            customAttributes: autocomplete="current-password"
        }
        sessionState {
            storage: request
        }
    )

    pageItem P9999_REMEMBER (
        type: checkbox
        label {
            label: Lembrar usuário
            alignment: right
        }
        layout {
            sequence: 30
            region: @ecloud
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_authentication.persistent_cookies_enabled
        }
    )

    pageItem P9999_USERNAME (
        type: textField
        label {
            label: Usuário
            alignment: right
        }
        layout {
            sequence: 10
            region: @ecloud
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 40
            valuePlaceholder: Usuário
        }
        validation {
            maxLength: 100
        }
        advanced {
            customAttributes: autocomplete="username"
        }
        sessionState {
            storage: request
        }
    )

    button login (
        buttonName: LOGIN
        label: Entrar
        layout {
            sequence: 40
            region: @ecloud
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process clear-page-s-cache (
        name: Clear Page(s) Cache
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 8432315493378625257
        }
    )

    process get-username-cookie (
        name: Get Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P9999_USERNAME := apex_authentication.get_login_username_cookie;
                :P9999_REMEMBER := case when :P9999_USERNAME is not null then 'Y' end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8432315022291625256
        }
    )

    process login (
        name: Login
        type: invokeApi
        invoke {
            package: APEX_AUTHENTICATION
            procedureOrFunction: LOGIN
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8432311537001625247
        }

        parameter p_password (
            value {
                type: item
                item: P9999_PASSWORD
            }
            advanced {
                displaySequence: 2
            }
        )

        parameter p_set_persistent_auth (
            parameter {
                dataType: boolean
                hasDefault: true
            }
            value {
                type: apiDefault
            }
            advanced {
                displaySequence: 3
            }
        )

        parameter p_username (
            value {
                type: item
                item: P9999_USERNAME
            }
            advanced {
                displaySequence: 1
            }
        )

    )

    process set-username-cookie (
        name: Set Username Cookie
        type: invokeApi
        invoke {
            package: APEX_AUTHENTICATION
            procedureOrFunction: SEND_LOGIN_USERNAME_COOKIE
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8432313635964625254
        }

        parameter p_consent (
            parameter {
                dataType: boolean
            }
            value {
                type: item
                item: P9999_REMEMBER
            }
            advanced {
                displaySequence: 2
            }
        )

        parameter p_username (
            value {
                type: expression
                plsqlExpression: lower( :P9999_USERNAME )
            }
            advanced {
                displaySequence: 1
            }
        )

    )

)


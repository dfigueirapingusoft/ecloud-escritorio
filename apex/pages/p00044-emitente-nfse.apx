    validation cliente-obrigatorio (
        name: Cliente quando o prestador é cliente
        validation {
            type: expression
            language: plsql
            plsqlExpression: :P44_PRESTADOR = 'ESCRITORIO' or :P44_CLIENTE_ID is not null
        }
        error {
            errorMessage: Escolha o cliente que presta o serviço.
            associatedItem: @P44_CLIENTE_ID
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    validation apuracao-sn (
        name: Apuração só para ME/EPP optante
        validation {
            type: expression
            language: plsql
            plsqlExpression: (:P44_OPCAO_SIMPLES = '3') = (:P44_REGIME_APURACAO_SN is not null)
        }
        error {
            errorMessage: Informe a apuração no Simples só quando o emitente é ME/EPP optante.
            associatedItem: @P44_REGIME_APURACAO_SN
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation apuracao-sn-novo (
        name: Apuração só para ME/EPP optante (novo)
        validation {
            type: expression
            language: plsql
            plsqlExpression: (:P44_NOVO_OPCAO_SIMPLES = '3') = (:P44_NOVO_REGIME_APURACAO_SN is not null)
        }
        error {
            errorMessage: Informe a apuração no Simples só quando o emitente é ME/EPP optante.
            associatedItem: @P44_NOVO_REGIME_APURACAO_SN
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    validation token-obrigatorio (
        name: Ambiente e token
        validation {
            type: expression
            language: plsql
            plsqlExpression: :P44_TOKEN_AMBIENTE is not null and :P44_TOKEN is not null
        }
        error {
            errorMessage: Escolha o ambiente e cole o token.
            associatedItem: @P44_TOKEN
        }
        execution {
            sequence: 40
        }
        serverSideCondition {
            whenButtonPressed: @definir-token
        }
    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @emitente
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1411865231
        }
    )

    process criar (
        name: Criar emitente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Escritório: p_cliente_id nulo. Documento, razão social e município vêm do cadastro.
                :P44_EMITENTE_ID := pkg_nfsen.criar_emitente(
                                        p_cliente_id         => case when :P44_PRESTADOR = 'CLIENTE' then to_number(:P44_CLIENTE_ID) end,
                                        p_opcao_simples      => :P44_NOVO_OPCAO_SIMPLES,
                                        p_regime_tributario  => :P44_NOVO_REGIME_TRIBUTARIO,
                                        p_regime_especial    => :P44_NOVO_REGIME_ESPECIAL,
                                        p_regime_apuracao_sn => :P44_NOVO_REGIME_APURACAO_SN);
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Emitente criado. Agora cadastre-o na Focus com o certificado A1.
        }
        advanced {
            executionMappingIdentifier: 1159731978
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    process process-form (
        name: Gravar formulário
        type: formAutoRowProcessing
        formRegion: @emitente
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Alterações salvas.
        }
        advanced {
            executionMappingIdentifier: 1860218925
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process validar (
        name: Validar na Focus (dry_run)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- dry_run=1: a Focus só valida (certificado, CNPJ, campos); nada é gravado lá.
                pkg_nfsen.cadastrar_na_focus(
                    p_emitente_id       => :P44_EMITENTE_ID,
                    p_temp_file_name    => :P44_CERTIFICADO,
                    p_senha_certificado => :P44_SENHA_CERTIFICADO,
                    p_dry_run           => true);
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Validação feita. Veja a situação do cadastro na Focus.
        }
        advanced {
            executionMappingIdentifier: 7228435582
        }
        serverSideCondition {
            whenButtonPressed: @validar
        }
    )

    process cadastrar (
        name: Cadastrar na Focus
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- POST /empresas (ou PUT se a empresa já existe na conta). Grava o vínculo e os
                -- tokens devolvidos nas Web Credentials do emitente.
                pkg_nfsen.cadastrar_na_focus(
                    p_emitente_id       => :P44_EMITENTE_ID,
                    p_temp_file_name    => :P44_CERTIFICADO,
                    p_senha_certificado => :P44_SENHA_CERTIFICADO);
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Cadastro na Focus atualizado.
        }
        advanced {
            executionMappingIdentifier: 2740425520
        }
        serverSideCondition {
            whenButtonPressed: @cadastrar
        }
    )

    process trocar-certificado (
        name: Trocar certificado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_nfsen.atualizar_certificado(
                    p_emitente_id       => :P44_EMITENTE_ID,
                    p_temp_file_name    => :P44_CERTIFICADO,
                    p_senha_certificado => :P44_SENHA_CERTIFICADO);
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Certificado enviado à Focus.
        }
        advanced {
            executionMappingIdentifier: 5785479445
        }
        serverSideCondition {
            whenButtonPressed: @trocar-certificado
        }
    )

    process sincronizar (
        name: Sincronizar com a Focus
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_nfsen.sincronizar_empresa(:P44_EMITENTE_ID);
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Dados da Focus atualizados.
        }
        advanced {
            executionMappingIdentifier: 5600138717
        }
        serverSideCondition {

page 44 (
    name: Emitente de NFS-e
    alias: EMITENTE-NFSE
    title: Emitente de NFS-e
    pageGroup: @nfsen
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region novo (
        name: Novo emitente
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Escolha quem presta o serviço. O documento, a razão social, o endereço e o município vêm do cadastro
                do escritório ou do cliente. Depois de criar, cadastre o emitente na Focus com o certificado A1.</p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P44_EMITENTE_ID
        }
    )

    region emitente (
        name: Dados do emitente
        type: form
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        source {
            location: localDatabase
            tableName: NFSEN_EMITENTE
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P44_EMITENTE_ID
        }
    )

    region padroes (
        name: Padrões das notas
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P44_EMITENTE_ID
        }
    )

    region focus (
        name: Cadastro na Focus NFe
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Situação do vínculo com a empresa na conta da plataforma. Tokens e certificado
                -- nunca aparecem: a tabela só marca se a Web Credential do ambiente existe.
                declare
                    l_html varchar2(32767);
                begin
                    for e in (select * from nfsen_emitente where emitente_id = :P44_EMITENTE_ID) loop
                        l_html := '<dl class="ecl-assinatura-info">'
                            || '<div><dt>Situação</dt><dd>' || case e.focus_situacao when 'CADASTRADA' then 'Cadastrada'
                                   when 'ERRO' then 'Com erro' else 'Ainda não cadastrada' end || '</dd></div>'
                            || case when e.focus_empresa_id is not null then
                                   '<div><dt>ID na Focus</dt><dd>' || e.focus_empresa_id || '</dd></div>' end
                            || '<div><dt>Ambiente</dt><dd>' || case e.ambiente when 'PRODUCAO' then 'Produção' else 'Homologação (sem validade fiscal)' end || '</dd></div>'
                            || '<div><dt>Token de homologação</dt><dd>' || case e.token_hom when 'S' then 'Definido' else 'Não definido' end || '</dd></div>'
                            || '<div><dt>Token de produção</dt><dd>' || case e.token_prod when 'S' then 'Definido' else 'Não definido' end || '</dd></div>'
                            || case when e.certificado_valido_ate is not null then
                                   '<div><dt>Certificado</dt><dd>' || to_char(e.certificado_valido_de, 'DD/MM/YYYY') || ' a '
                                   || to_char(e.certificado_valido_ate, 'DD/MM/YYYY')
                                   || case when e.certificado_valido_ate < systimestamp then ' (vencido)'
                                           when e.certificado_valido_ate < systimestamp + interval '30' day then ' (vence em menos de 30 dias)' end
                                   || '</dd></div>' end
                            || case when e.focus_sincronizado_em is not null then
                                   '<div><dt>Última sincronização</dt><dd>' || to_char(e.focus_sincronizado_em, 'DD/MM/YYYY HH24:MI') || '</dd></div>' end
                            || '</dl>'
                            || case when e.focus_mensagem is not null then
                                   '<p class="' || case when e.focus_situacao = 'ERRO' then 'u-danger-text' else 'u-warning-text' end || '">'
                                   || apex_escape.html(e.focus_mensagem) || '</p>' end;
                    end loop;
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P44_EMITENTE_ID
        }
    )

    region certificado (
        name: Certificado A1
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>O certificado e a senha vão direto para a Focus e não ficam guardados no Ecloud. Use <strong>Validar</strong>
                para conferir sem gravar nada na Focus.</p>
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P44_EMITENTE_ID
        }
        security {
            authorizationScheme: @administrador
        }
    )

    region token (
        name: Token informado à mão
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Só quando a Focus não devolver o token da empresa no cadastro: cole o token do painel. Ele vai para a
                Web Credential do emitente e não fica em tabela nem no log.</p>
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P44_EMITENTE_ID
        }
        security {
            authorizationScheme: @admin-plataforma
        }
    )

    region buttons (
        name: Botões
        type: staticContent
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P44_PRESTADOR (
        type: radioGroup
        label {
            label: Prestador
            alignment: right
        }

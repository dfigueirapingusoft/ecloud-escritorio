    process definir-token (
        name: Gravar token
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Vai para a Web Credential FOCUS_<EMITENTE_ID>_H/_P; o item é só do pedido.
                pkg_focus_api.definir_token(:P44_EMITENTE_ID, :P44_TOKEN_AMBIENTE, :P44_TOKEN);
                ```
        }
        execution {
            sequence: 90
        }
        successMessage {
            successMessage: Token gravado na Web Credential do emitente.
        }
        advanced {
            executionMappingIdentifier: 9471228733
        }
        serverSideCondition {
            whenButtonPressed: @definir-token
        }
    )

    branch reabrir (
        name: Reabrir o emitente
        execution {
            sequence: 10
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 44
                items: {
                    P44_EMITENTE_ID: &P44_EMITENTE_ID.
                }
            }
        }
    )


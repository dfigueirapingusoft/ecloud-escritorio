        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        lov {
            type: staticValues
            staticValues: STATIC:O próprio escritório (honorários);ESCRITORIO,Um cliente do escritório;CLIENTE
            displayNullValue: false
        }
        default {
            type: static
            staticValue: CLIENTE
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: itemIsNull
            item: P44_EMITENTE_ID
        }
    )


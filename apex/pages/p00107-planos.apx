page 107 (
    name: Planos
    alias: PLANOS
    title: Planos
    pageGroup: @administracao
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @admin-plataforma
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region planos (
        name: Planos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.plano_id,
                       p.codigo,
                       p.nome,
                       p.preco_mensal,
                       p.meses_cobranca,
                       p.preco_mensal * p.meses_cobranca as valor_fatura,
                       p.ordem,
                       p.publico,
                       p.ativo,
                       (select count(*) from assinatura a
                         where a.plano_id = p.plano_id and a.situacao <> 'CANCELADA') as assinaturas
                  from plano p
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 108
                items: {
                    P108_PLANO_ID: \#PLANO_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum plano cadastrado.
        }
        actionsMenu {
            subscription: false
        }

        column PLANO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
        )

        column PRECO_MENSAL (
            type: plainText
            heading {
                heading: Preço por mês
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            layout {
                sequence: 4
            }
            source {
                dataType: number
            }
        )

        column MESES_COBRANCA (
            type: plainText
            heading {
                heading: Meses por fatura
            }
            layout {
                sequence: 5
            }
            source {
                dataType: number
            }
        )

        column VALOR_FATURA (
            type: plainText
            heading {
                heading: Valor da fatura
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            layout {
                sequence: 6
            }
            source {
                dataType: number
            }
        )

        column ORDEM (
            type: plainText
            heading {
                heading: Ordem
            }
            layout {
                sequence: 7
            }
            source {
                dataType: number
            }
        )

        column PUBLICO (
            type: plainTextBasedOnLov
            heading {
                heading: No cadastro
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
        )

        column ATIVO (
            type: plainTextBasedOnLov
            heading {
                heading: Ativo
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
        )

        column ASSINATURAS (
            type: plainText
            heading {
                heading: Assinaturas em vigor
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
        )

        savedReport 1071100001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODIGO (
                sequence: 1
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn PRECO_MENSAL (
                sequence: 3
            )

            displayColumn MESES_COBRANCA (
                sequence: 4
            )

            displayColumn VALOR_FATURA (
                sequence: 5
            )

            displayColumn ORDEM (
                sequence: 6
            )

            displayColumn PUBLICO (
                sequence: 7
            )

            displayColumn ATIVO (
                sequence: 8
            )

            displayColumn ASSINATURAS (
                sequence: 9
            )

            sort (
                column: ORDEM
                sort {
                    sequence: 1
                }
            )

        )
    )

    region aviso (
        name: Aviso de pagamento da Stone
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- URL do webhook para colar no painel da Stone (eventos order.* e charge.*).
                declare
                    l_url varchar2(4000) := pkg_ecloud_assinatura.url_aviso;
                begin
                    if l_url is null then
                        return '<p>Preencha <code>WEBHOOK_BASE_URL</code> na Configuração (ex.: '
                            || 'https://xxxx.adb.sa-saopaulo-1.oraclecloudapps.com/ords/wksp_ecloud) '
                            || 'para ver a URL do aviso de pagamento.</p>';
                    end if;
                    return '<p>Cadastre esta URL no painel da Stone (Configurações > Webhooks), '
                        || 'com os eventos <code>order.*</code> e <code>charge.*</code>:</p>'
                        || '<pre class="ecl-url-aviso">' || apex_escape.html(l_url) || '</pre>'
                        || '<p class="u-text-secondary">O token no fim da URL é secreto: não compartilhe.</p>';
                end;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Criar plano
        layout {
            sequence: 10
            region: @planos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 108
                clearCache: 108
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-after-dialog (
        name: Atualizar após fechar o diálogo
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @planos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @planos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

        }
    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @nota
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8400304920
        }
    )

    process criar (
        name: Criar rascunho
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Emitente ESCRITORIO: a nota é do cliente tomador. Emitente CLIENTE: a nota é do
                -- próprio cliente prestador e o tomador vem do cadastro ou dos campos digitados.
                declare
                    l_tipo nfsen_emitente.tipo%type;
                    l_cli  nfsen_emitente.cliente_id%type;
                begin
                    select tipo, cliente_id into l_tipo, l_cli
                      from nfsen_emitente
                     where emitente_id = :P46_NOVO_EMITENTE_ID;
                    if l_tipo = 'ESCRITORIO' then
                        if :P46_NOVO_TOMADOR_ID is null then
                            raise_application_error(pkg_nfsen.c_err_dados, 'Escolha o cliente tomador.');
                        end if;
                        :P46_NOTA_ID := pkg_nfsen.criar_rascunho(
                                            p_emitente_id       => :P46_NOVO_EMITENTE_ID,
                                            p_cliente_id        => :P46_NOVO_TOMADOR_ID,
                                            p_valor_servico     => to_number(:P46_NOVO_VALOR),
                                            p_descricao_servico => :P46_NOVO_DESCRICAO);
                    else
                        :P46_NOTA_ID := pkg_nfsen.criar_rascunho(
                                            p_emitente_id          => :P46_NOVO_EMITENTE_ID,
                                            p_cliente_id           => l_cli,
                                            p_valor_servico        => to_number(:P46_NOVO_VALOR),
                                            p_descricao_servico    => :P46_NOVO_DESCRICAO,
                                            p_tomador_cliente_id   => :P46_NOVO_TOMADOR_ID,
                                            p_tomador_tipo_doc     => :P46_NOVO_TOMADOR_TIPO_DOC,
                                            p_tomador_documento    => :P46_NOVO_TOMADOR_DOCUMENTO,
                                            p_tomador_razao_social => :P46_NOVO_TOMADOR_RAZAO);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Rascunho criado. Confira os dados e emita.
        }
        advanced {
            executionMappingIdentifier: 2943459067
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    process process-form (
        name: Gravar formulário
        type: formAutoRowProcessing
        formRegion: @nota
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1916404419

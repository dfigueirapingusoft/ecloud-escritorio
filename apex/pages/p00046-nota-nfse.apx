    pageItem P46_NOVO_EMITENTE_ID (
        type: selectList
        label {
            label: Prestador (emitente)
            alignment: right
        }
        layout {
            sequence: 10
            region: @novo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select razao_social || ' (' || pkg_rural_cadastro.formatar_documento(coalesce(cnpj, cpf)) || ')' d, emitente_id r
                  from nfsen_emitente
                 where ativo = 'S'
                 order by case tipo when 'ESCRITORIO' then 0 else 1 end, razao_social
                ```
            displayNullValue: true
            nullDisplayValue: - Selecione -
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: itemIsNull
            item: P46_NOTA_ID
        }
    )


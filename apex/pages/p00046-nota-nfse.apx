    validation tomador-novo (
        name: Tomador do rascunho
        validation {
            type: expression
            language: plsql
            plsqlExpression: :P46_NOVO_TOMADOR_ID is not null or (:P46_NOVO_TOMADOR_TIPO_DOC is not null and :P46_NOVO_TOMADOR_RAZAO is not null)
        }
        error {
            errorMessage: Escolha o tomador no cadastro ou informe o documento e o nome.
            associatedItem: @P46_NOVO_TOMADOR_ID
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    validation justificativa (
        name: Justificativa de 15 a 255 caracteres
        validation {
            type: expression
            language: plsql
            plsqlExpression: length(trim(:P46_JUSTIFICATIVA)) between 15 and 255
        }
        error {
            errorMessage: Escreva uma justificativa de 15 a 255 caracteres.
            associatedItem: @P46_JUSTIFICATIVA
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @cancelar-nota
        }
    )


        name: Cancelamento
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from nfsen_nota where nota_id = :P46_NOTA_ID and status = 'AUTORIZADA'
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )


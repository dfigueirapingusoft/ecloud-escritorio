            value: SAVE,EMITIR,DELETE
        }
    )

    process emitir (
        name: Emitir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- POST /nfsen?ref=: a resposta é assíncrona (202). O webhook ou o job atualizam a situação.
                pkg_nfsen.emitir(:P46_NOTA_ID);
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Nota enviada. A Focus está processando; a situação muda sozinha.

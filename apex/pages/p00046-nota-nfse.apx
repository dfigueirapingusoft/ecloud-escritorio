page 46 (
    name: Nota de serviço (NFS-e)
    alias: NOTA-NFSE
    title: Nota de serviço (NFS-e)
    pageGroup: @nfsen
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region novo (
        name: Nova nota
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>O rascunho nasce com os padrões do emitente (serviço, alíquota, IBS/CBS) e os dados do tomador do cadastro.
                Confira e complete antes de emitir.</p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P46_NOTA_ID
        }
    )

    region situacao (
        name: Situação
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Situação da nota, retorno da Focus e pendências do rascunho.
                declare
                    l_html varchar2(32767);
                    l_pend varchar2(4000);
                begin
                    for n in (select n.*, e.razao_social emitente
                                from nfsen_nota n
                                join nfsen_emitente e on e.emitente_id = n.emitente_id
                               where n.nota_id = :P46_NOTA_ID)
                    loop
                        l_html := '<dl class="ecl-assinatura-info">'
                            || '<div><dt>Situação</dt><dd>' || apex_escape.html(initcap(replace(n.status, '_', ' '))) || '</dd></div>'
                            || '<div><dt>Prestador</dt><dd>' || apex_escape.html(n.emitente) || '</dd></div>'
                            || case when n.ambiente is not null then '<div><dt>Ambiente</dt><dd>'
                                   || case n.ambiente when 'PRODUCAO' then 'Produção' else 'Homologação (sem validade fiscal)' end || '</dd></div>' end
                            || case when n.referencia is not null then '<div><dt>Referência</dt><dd>' || apex_escape.html(n.referencia) || '</dd></div>' end
                            || case when n.numero_dps is not null then '<div><dt>DPS</dt><dd>série ' || n.serie_dps || ', nº ' || n.numero_dps || '</dd></div>' end
                            || case when n.numero_nfse is not null then '<div><dt>NFS-e</dt><dd>nº ' || apex_escape.html(n.numero_nfse) || '</dd></div>' end
                            || case when n.chave_acesso is not null then '<div><dt>Chave de acesso</dt><dd>' || apex_escape.html(n.chave_acesso) || '</dd></div>' end
                            || case when n.url_consulta is not null then '<div><dt>Consulta pública</dt><dd><a href="'
                                   || apex_escape.html_attribute(n.url_consulta) || '" target="_blank" rel="noopener">abrir</a></dd></div>' end
                            || '</dl>';
                        if n.mensagem is not null then
                            l_html := l_html || '<p class="' || case when n.status in ('AUTORIZADA','PROCESSANDO','CANCELADA') then 'u-info-text' else 'u-danger-text' end
                                || '">' || apex_escape.html(n.mensagem) || '</p>';
                        end if;
                        if n.erros is not null then
                            l_html := l_html || '<ul>';
                            for r in (select codigo, mensagem, correcao
                                        from json_table(n.erros, '$[*]'
                                                 columns (codigo varchar2(30) path '$.codigo',
                                                          mensagem varchar2(4000) path '$.mensagem',
                                                          correcao varchar2(4000) path '$.correcao')))
                            loop
                                l_html := l_html || '<li><strong>' || apex_escape.html(r.codigo) || '</strong> '
                                    || apex_escape.html(r.mensagem)
                                    || case when r.correcao is not null then '<br>Correção: ' || apex_escape.html(r.correcao) end || '</li>';
                            end loop;
                            l_html := l_html || '</ul>';
                        end if;
                        if n.status in ('RASCUNHO','REJEITADA') then
                            l_pend := pkg_nfsen.pendencias(n.nota_id);
                            l_html := l_html || case when l_pend is null then '<p class="u-success-text">Pronta para emitir.</p>'
                                else '<p class="u-warning-text">Antes de emitir:<br>'
                                     || replace(apex_escape.html(l_pend), chr(10), '<br>') || '</p>' end;
                        end if;
                    end loop;
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P46_NOTA_ID
        }
    )

    region nota (
        name: Tomador
        type: form
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        source {
            location: localDatabase
            tableName: NFSEN_NOTA
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P46_NOTA_ID
        }
    )

    region servico (
        name: Serviço
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P46_NOTA_ID

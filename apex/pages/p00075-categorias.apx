page 75 (
    name: Categorias do livro caixa
    alias: CATEGORIAS
    title: Categorias do livro caixa
    pageGroup: @rural
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <p>Plano de categorias do escritório, comum a todos os produtores. O tipo no LCDPR decide se o lançamento entra no arquivo: 1 receita rural, 2 custeio e investimento, 3 produto entregue de adiantamento; vazio fica fora.</p>
            ```
    }
    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region acoes (
        name: Ações
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region categorias (
        name: Categorias
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CATEGORIA_CAIXA
            orderByClause: codigo
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        advanced {
            savedReportMappingIdentifier: 9207426672
        }
        savedReport 494401926 (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 50
            }
            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @CATEGORIA_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @CODIGO
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @NOME
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @NATUREZA
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @TIPO_LANC
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @GRUPO
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @ATIVO
                layout {
                    sequence: 7
                }
            )
        )
        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )
        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )
        column CATEGORIA_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: CATEGORIA_ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )
        column CODIGO (
            type: textField
            heading {
                heading: Código
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 20
            }
            source {
                databaseColumn: CODIGO
                dataType: varchar2
            }
        )
        column NOME (
            type: textField
            heading {
                heading: Nome
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
        )
        column NATUREZA (
            type: selectList
            heading {
                heading: Natureza
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @natureza
                displayNullValue: true
            }
            source {
                databaseColumn: NATUREZA
                dataType: varchar2
            }
            columnFilter {
                lovType: none
            }
        )
        column TIPO_LANC (
            type: selectList
            heading {
                heading: Tipo no LCDPR
            }
            layout {
                sequence: 70
            }
            lov {
                type: sharedComponent
                lov: @tipo-lanc
                displayNullValue: true
                nullDisplayValue: Fora do LCDPR
            }
            source {
                databaseColumn: TIPO_LANC
                dataType: varchar2
            }
            columnFilter {
                lovType: none
            }
        )
        column GRUPO (
            type: selectList
            heading {
                heading: Grupo
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @grupo-categoria
                displayNullValue: true
            }
            source {
                databaseColumn: GRUPO
                dataType: varchar2
            }
            columnFilter {
                lovType: none
            }
        )
        column ATIVO (
            type: selectList
            heading {
                heading: Ativa
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @sim-nao
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: S
            }
            columnFilter {
                lovType: none
            }
        )
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @acoes
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            icon: fa-save
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    button padrao (
        buttonName: PADRAO
        label: Criar plano padrão
        layout {
            sequence: 20
            region: @acoes
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            icon: fa-magic
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Criar as categorias padrão que ainda não existem no escritório?
            style: danger
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    process save-categorias (
        name: Gravar categorias
        type: interactiveGridAutoRowProcessing
        editableRegion: @categorias
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Alterações gravadas.
        }
        advanced {
            executionMappingIdentifier: 8332145897
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process criar-padrao (
        name: Criar plano padrão
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_qtd number;
                begin
                    -- Só cria os códigos que ainda não existem; não altera os existentes.
                    l_qtd := pkg_rural_cadastro.criar_categorias_padrao;
                    apex_application.g_print_success_message := l_qtd || ' categoria(s) criada(s).';
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 9069683836
        }
        serverSideCondition {
            whenButtonPressed: @padrao
        }
    )

    branch recarregar (
        name: Recarregar a página
        execution {
            sequence: 99
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 75
            }
        }
    )
)

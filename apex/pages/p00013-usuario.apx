page 13 (
    name: Usuário
    alias: USUARIO
    title: Usuário
    pageGroup: @administracao
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    security {
        authorizationScheme: @administrador
    }

    region buttons (
        name: Botões
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region usuario (
        name: Usuário
        type: form
        source {
            location: localDatabase
            tableName: USUARIO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P13_USUARIO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @usuario
            slot: regionBody
        }
        source {
            formRegion: @usuario
            column: USUARIO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P13_USERNAME (
        type: textField
        label {
            label: Usuário (conta APEX)
            alignment: right
        }
        layout {
            sequence: 20
            region: @usuario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @usuario
            column: USERNAME
            dataType: varchar2
        }
        help {
            inlineHelpText: Mesmo nome da conta do Oracle APEX; gravado em maiúsculas.
        }
    )

    pageItem P13_NOME (
        type: textField
        label {
            label: Nome
            alignment: right
        }
        layout {
            sequence: 30
            region: @usuario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
        source {
            formRegion: @usuario
            column: NOME
            dataType: varchar2
        }
    )

    pageItem P13_EMAIL (
        type: textField
        label {
            label: E-mail
            alignment: right
        }
        layout {
            sequence: 40
            region: @usuario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @usuario
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P13_PERFIL (
        type: selectList
        label {
            label: Perfil
            alignment: right
        }
        layout {
            sequence: 50
            region: @usuario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @perfis
            displayNullValue: true
            nullDisplayValue: - Selecione -
        }
        source {
            formRegion: @usuario
            column: PERFIL
            dataType: varchar2
        }
    )

    pageItem P13_ADMIN_PLATAFORMA (
        type: switch
        label {
            label: Administrador da plataforma
            alignment: right
        }
        layout {
            sequence: 60
            region: @usuario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            useDefaults: false
            onValue: S
            offValue: N
        }
        source {
            formRegion: @usuario
            column: ADMIN_PLATAFORMA
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
        readOnly {
            type: expression
            plsqlExpression: not pkg_ecloud_ctx.is_admin_plataforma
        }
    )

    pageItem P13_ATIVO (
        type: switch
        label {
            label: Ativo
            alignment: right
        }
        layout {
            sequence: 70
            region: @usuario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            useDefaults: false
            onValue: S
            offValue: N
        }
        source {
            formRegion: @usuario
            column: ATIVO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: S
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_USUARIO_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_USUARIO_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P13_USUARIO_ID
        }
    )

    validation username-unico (
        name: Usuário único
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_qtd number;
                begin
                    -- consulta sem VPD não é possível aqui; a constraint única cobre outros escritórios
                    select count(*) into l_qtd
                      from usuario
                     where username = upper(trim(:P13_USERNAME))
                       and usuario_id <> coalesce(to_number(:P13_USUARIO_ID), -1);
                    return l_qtd = 0;
                end;
                ```
        }
        error {
            errorMessage: Já existe um usuário com esse nome.
            associatedItem: @P13_USERNAME
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process normalizar-username (
        name: Normalizar usuário
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P13_USERNAME := upper(trim(:P13_USERNAME));
                ```
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 1736730401
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancelar diálogo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @usuario
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4950682871
        }
    )

    process process-form (
        name: Gravar formulário
        type: formAutoRowProcessing
        formRegion: @usuario
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1315891760
        }
    )

    process close-dialog (
        name: Fechar diálogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 2269024110
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)

page 10 (
    name: Escritórios
    alias: ESCRITORIOS
    title: Escritórios
    pageGroup: @administracao
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @admin-plataforma
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region escritorios (
        name: Escritórios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select escritorio_id,
                       pkg_ecloud_util.formatar_cnpj(cnpj) as cnpj,
                       razao_social,
                       nome_fantasia,
                       uf,
                       municipio_ibge,
                       email,
                       telefone,
                       ativo
                  from escritorio
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 11
                items: {
                    P11_ESCRITORIO_ID: \#ESCRITORIO_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        actionsMenu {
            subscription: false
        }

        column ESCRITORIO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
        )

        column CNPJ (
            type: plainText
            heading {
                heading: CNPJ
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
        )

        column RAZAO_SOCIAL (
            type: plainText
            heading {
                heading: Razão social
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
        )

        column NOME_FANTASIA (
            type: plainText
            heading {
                heading: Nome fantasia
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
        )

        column UF (
            type: plainText
            heading {
                heading: UF
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
        )

        column MUNICIPIO_IBGE (
            type: plainText
            heading {
                heading: Município IBGE
            }
            layout {
                sequence: 6
            }
            source {
                dataType: number
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: E-mail
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
        )

        column ATIVO (
            type: plainTextBasedOnLov
            heading {
                heading: Ativo
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
        )

        savedReport 672874709 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CNPJ (
                sequence: 1
            )

            displayColumn RAZAO_SOCIAL (
                sequence: 2
            )

            displayColumn NOME_FANTASIA (
                sequence: 3
            )

            displayColumn UF (
                sequence: 4
            )

            displayColumn MUNICIPIO_IBGE (
                sequence: 5
            )

            displayColumn EMAIL (
                sequence: 6
            )

            displayColumn TELEFONE (
                sequence: 7
            )

            displayColumn ATIVO (
                sequence: 8
            )

            sort (
                column: RAZAO_SOCIAL
                sort {
                    sequence: 1
                }
            )

        )
    )

    region operar (
        name: Operar em outro escritório (suporte)
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Como administrador da plataforma você pode operar dentro de outro escritório
                para dar suporte. Os dados exibidos passam a ser os do escritório escolhido até você voltar ao seu.</p>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10_ESCRITORIO_ATIVO (
        type: selectList
        label {
            label: Escritório ativo
            alignment: right
        }
        layout {
            sequence: 10
            region: @operar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @escritorios
            displayNullValue: true
            nullDisplayValue: - Meu escritório -
        }
        source {
            type: item
            item: F_ESCRITORIO_ATIVO
        }
        sessionState {
            storage: request
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
    )

    button create (
        buttonName: CREATE
        label: Criar escritório
        layout {
            sequence: 10
            region: @escritorios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button operar (
        buttonName: OPERAR
        label: Operar neste escritório
        layout {
            sequence: 20
            region: @operar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-after-dialog (
        name: Atualizar após fechar o diálogo
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @escritorios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @escritorios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process definir-escritorio-ativo (
        name: Definir escritório ativo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Guarda o escritório escolhido; o Initialization PL/SQL Code aplica a troca
                -- (pkg_ecloud_ctx.trocar_escritorio) a cada requisição.
                apex_util.set_session_state('F_ESCRITORIO_ATIVO', :P10_ESCRITORIO_ATIVO);
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2513626224
        }
        successMessage {
            successMessage: Escritório ativo alterado.
        }
        serverSideCondition {
            whenButtonPressed: @operar
        }
    )

)

page 20 (
    name: Clientes
    alias: CLIENTES
    title: Clientes
    pageGroup: @cadastros
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region clientes (
        name: Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.cliente_id,
                       pkg_ecloud_util.formatar_cnpj(c.cnpj) as cnpj,
                       c.razao_social,
                       c.nome_fantasia,
                       c.uf,
                       c.municipio_ibge,
                       m.nome as municipio,
                       c.regime,
                       c.crt,
                       c.email,
                       c.telefone,
                       c.ativo
                  from cliente c
                  left join rtc_da_municipio m
                    on m.codigo = c.municipio_ibge
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 21
                items: {
                    P21_CLIENTE_ID: \#CLIENTE_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        actionsMenu {
            subscription: false
        }

        column CLIENTE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
        )

        column CNPJ (
            type: plainText
            heading {
                heading: CNPJ
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
        )

        column RAZAO_SOCIAL (
            type: plainText
            heading {
                heading: Razão social
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
        )

        column NOME_FANTASIA (
            type: plainText
            heading {
                heading: Nome fantasia
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
        )

        column UF (
            type: plainText
            heading {
                heading: UF
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
        )

        column MUNICIPIO_IBGE (
            type: plainText
            heading {
                heading: Município IBGE
            }
            layout {
                sequence: 6
            }
            source {
                dataType: number
            }
        )

        column MUNICIPIO (
            type: plainText
            heading {
                heading: Município
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
        )

        column REGIME (
            type: plainTextBasedOnLov
            heading {
                heading: Regime
            }
            lov {
                lov: @regimes
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
        )

        column CRT (
            type: plainTextBasedOnLov
            heading {
                heading: CRT
            }
            lov {
                lov: @crt
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: E-mail
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
        )

        column ATIVO (
            type: plainTextBasedOnLov
            heading {
                heading: Ativo
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
        )

        savedReport 304652968 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CNPJ (
                sequence: 1
            )

            displayColumn RAZAO_SOCIAL (
                sequence: 2
            )

            displayColumn NOME_FANTASIA (
                sequence: 3
            )

            displayColumn UF (
                sequence: 4
            )

            displayColumn MUNICIPIO_IBGE (
                sequence: 5
            )

            displayColumn MUNICIPIO (
                sequence: 6
            )

            displayColumn REGIME (
                sequence: 7
            )

            displayColumn CRT (
                sequence: 8
            )

            displayColumn EMAIL (
                sequence: 9
            )

            displayColumn TELEFONE (
                sequence: 10
            )

            displayColumn ATIVO (
                sequence: 11
            )

            sort (
                column: RAZAO_SOCIAL
                sort {
                    sequence: 1
                }
            )

        )
    )

    button create (
        buttonName: CREATE
        label: Criar cliente
        layout {
            sequence: 10
            region: @clientes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
                clearCache: 21
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    dynamicAction refresh-after-dialog (
        name: Atualizar após fechar o diálogo
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @clientes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @clientes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

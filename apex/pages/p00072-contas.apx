page 72 (
    name: Contas bancárias
    alias: CONTAS
    title: Contas bancárias
    pageGroup: @rural
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <p>Contas do produtor (registro 0050 do LCDPR). O caixa em dinheiro é a conta do tipo Caixa, com código 000.</p>
            ```
    }
    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
        }
    )

    pageItem P72_CLIENTE_ID (
        type: selectList
        label {
            label: Produtor rural
            alignment: right
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @produtores
            displayNullValue: true
            nullDisplayValue: - Selecione o produtor -
        }
        sessionState {
            storage: session
        }
    )

    region sem-produtor (
        name: Selecione o produtor
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Selecione o produtor rural para ver os dados. Produtores são clientes pessoa física, cadastrados em Clientes.</p>
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P72_CLIENTE_ID
        }
    )

    region contas (
        name: Contas bancárias e caixa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cb.conta_id,
                       lpad(cb.cod_conta, 3, '0') as cod_conta,
                       cb.apelido,
                       cb.tipo,
                       cb.banco_codigo,
                       cb.banco_nome,
                       cb.agencia,
                       cb.conta_numero,
                       cb.saldo_inicial,
                       cb.data_saldo_inicial,
                       v.saldo_livro,
                       v.saldo_banco,
                       v.data_saldo_banco,
                       v.itens_extrato_pendentes,
                       cb.ativo
                  from conta_bancaria cb
                  join vw_conta_conciliacao v
                    on v.conta_id = cb.conta_id
                 where cb.cliente_id = :P72_CLIENTE_ID
                ```
            pageItemsToSubmit: P72_CLIENTE_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 73
                items: {
                    P73_CONTA_ID: \#CONTA_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Abrir"><span class="fa fa-edit" aria-hidden="true" title="Abrir"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        actionsMenu {
            subscription: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P72_CLIENTE_ID
        }
        column CONTA_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
        )
        column COD_CONTA (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
        )
        column APELIDO (
            type: plainText
            heading {
                heading: Conta
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
        )
        column TIPO (
            type: plainTextBasedOnLov
            heading {
                heading: Tipo
            }
            lov {
                lov: @tipo-conta
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
        )
        column BANCO_CODIGO (
            type: plainText
            heading {
                heading: Banco
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
        )
        column BANCO_NOME (
            type: plainText
            heading {
                heading: Nome do banco
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
        )
        column AGENCIA (
            type: plainText
            heading {
                heading: Agência
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
        )
        column CONTA_NUMERO (
            type: plainText
            heading {
                heading: Número
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
        )
        column SALDO_INICIAL (
            type: plainText
            heading {
                heading: Saldo inicial
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
        )
        column DATA_SALDO_INICIAL (
            type: plainText
            heading {
                heading: Data do saldo inicial
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
            source {
                dataType: date
            }
        )
        column SALDO_LIVRO (
            type: plainText
            heading {
                heading: Saldo no livro
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
        )
        column SALDO_BANCO (
            type: plainText
            heading {
                heading: Saldo no banco
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
        )
        column DATA_SALDO_BANCO (
            type: plainText
            heading {
                heading: Data do saldo do banco
            }
            layout {
                sequence: 13
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
            source {
                dataType: date
            }
        )
        column ITENS_EXTRATO_PENDENTES (
            type: plainText
            heading {
                heading: Extrato a conciliar
                alignment: end
            }
            layout {
                sequence: 14
                columnAlignment: end
            }
            source {
                dataType: number
            }
        )
        column ATIVO (
            type: plainTextBasedOnLov
            heading {
                heading: Ativa
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
        )
        savedReport 236661093 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }
            displayColumn COD_CONTA (
                sequence: 1
            )
            displayColumn APELIDO (
                sequence: 2
            )
            displayColumn TIPO (
                sequence: 3
            )
            displayColumn BANCO_CODIGO (
                sequence: 4
            )
            displayColumn BANCO_NOME (
                sequence: 5
            )
            displayColumn AGENCIA (
                sequence: 6
            )
            displayColumn CONTA_NUMERO (
                sequence: 7
            )
            displayColumn SALDO_INICIAL (
                sequence: 8
            )
            displayColumn DATA_SALDO_INICIAL (
                sequence: 9
            )
            displayColumn SALDO_LIVRO (
                sequence: 10
            )
            displayColumn SALDO_BANCO (
                sequence: 11
            )
            displayColumn DATA_SALDO_BANCO (
                sequence: 12
            )
            displayColumn ITENS_EXTRATO_PENDENTES (
                sequence: 13
            )
            displayColumn ATIVO (
                sequence: 14
            )
            sort (
                column: COD_CONTA
                sort {
                    sequence: 1
                }
            )
        )
    )

    button create (
        buttonName: CREATE
        label: Cadastrar conta
        layout {
            sequence: 10
            region: @contas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 73
                clearCache: 73
                items: {
                    P73_CLIENTE_ID: &P72_CLIENTE_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    dynamicAction refresh-after-dialog (
        name: Atualizar após fechar o diálogo
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @contas
        }
        action refresh-contas (
            action: refresh
            affectedElements {
                selectionType: region
                region: @contas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    dynamicAction trocar-filtro (
        name: Recarregar ao trocar o filtro
        execution {
            sequence: 50
        }
        when {
            event: change
            selectionType: items
            items: P72_CLIENTE_ID
        }
        action native-submit (
            action: submitPage
            settings {
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process carregar-produtor (
        name: Carregar o produtor escolhido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- O produtor escolhido em qualquer página do módulo fica em F_PRODUTOR_ID.
                if :F_PRODUTOR_ID is not null then
                    :P72_CLIENTE_ID := :F_PRODUTOR_ID;
                end if;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6998304908
        }
    )

    process guardar-produtor (
        name: Guardar o produtor escolhido
        type: executeCode
        source {
            plsqlCode: :F_PRODUTOR_ID := :P72_CLIENTE_ID;
        }
        execution {
            sequence: 1
        }
        advanced {
            executionMappingIdentifier: 2876227743
        }
    )

    branch recarregar (
        name: Recarregar a página
        execution {
            sequence: 99
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 72
            }
        }
    )
)

page 53 (
    name: NBS
    alias: NBS
    title: NBS
    pageGroup: @consultas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region nbs (
        name: NBS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select codigo,
                       descricao,
                       data_referencia
                  from rtc_da_nbs
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        actionsMenu {
            subscription: false
        }

        column CODIGO (
            type: plainText
            heading {
                heading: NBS
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
        )

        column DATA_REFERENCIA (
            type: plainText
            heading {
                heading: Data de referência
            }
            layout {
                sequence: 3
            }
            source {
                dataType: date
            }
        )

        savedReport 599679445 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODIGO (
                sequence: 1
            )

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn DATA_REFERENCIA (
                sequence: 3
            )

            sort (
                column: CODIGO
                sort {
                    sequence: 1
                }
            )

        )
    )

    region cache (
        name: Atualização do cache
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Dados abertos das calculadoras guardados no banco e atualizados todo dia pelo job de sincronização.</p>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region cache-status (
        name: Última sincronização
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao,
                       cast(ultima_sincronizacao as date) as ultima_sincronizacao,
                       data_referencia,
                       qtd_registros,
                       status,
                       mensagem
                  from rtc_cache_controle
                 where recurso in ('NBS')
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nenhum registro.
        }

        column DESCRICAO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Recurso
            }
            layout {
                sequence: 1
            }
        )

        column ULTIMA_SINCRONIZACAO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Última sincronização
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
        )

        column DATA_REFERENCIA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data de referência
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
        )

        column QTD_REGISTROS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Registros
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
        )

        column STATUS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 5
            }
        )

        column MENSAGEM (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Mensagem
            }
            layout {
                sequence: 6
            }
        )

    )

)

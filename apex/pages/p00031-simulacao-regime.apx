        }
        serverSideCondition {
            type: itemIsNull
            item: P31_SIMULACAO_ID
        }
    )

    region totais (
        name: Totais
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select qtd_itens,
                       qtd_itens_pendentes,
                       tot_base_calculo,
                       tot_cbs,
                       tot_ibs,
                       tot_is,
                       tot_tributos,
                       versao_app_calc || ' / ' || versao_db_calc as versao_calculadora,
                       case when warning_dados_simulados is not null
                            then 'Sim (' || warning_dados_simulados || ')' else 'Não' end as dados_simulados,
                       cast(processada_em as date) as processada_em
                  from simulacao
                 where simulacao_id = :P31_SIMULACAO_ID
                ```
            pageItemsToSubmit: P31_SIMULACAO_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nenhum registro.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P31_STATUS is not null and :P31_STATUS <> 'RASCUNHO'
        }


            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3400353623
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P31_SIMULACAO_ID
        }


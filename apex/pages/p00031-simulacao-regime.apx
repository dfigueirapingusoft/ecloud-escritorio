    region erros (
        name: Erros e pendências
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.numero_item,
                       e.codigo,
                       e.mensagem_amigavel,
                       c.orientacao
                  from simulacao_item_erro e
                  left join rtc_erro_catalogo c
                    on c.codigo = e.codigo
                 where e.simulacao_id = :P31_SIMULACAO_ID
                 order by e.numero_item nulls first, e.erro_id
                ```
            pageItemsToSubmit: P31_SIMULACAO_ID
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        messages {
            whenNoDataFound: Nenhum registro.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from simulacao_item_erro where simulacao_id = :P31_SIMULACAO_ID
        }

        column NUMERO_ITEM (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Item
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
        )

        column CODIGO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Código
            }
            layout {
                sequence: 2
            }
        )

        column MENSAGEM_AMIGAVEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: O que aconteceu
            }
            layout {
                sequence: 3
            }
        )

        column ORIENTACAO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Como corrigir
            }
            layout {
                sequence: 4
            }
        )

    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 30
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P31_SIMULACAO_ID
        }
    )


    region resultado (
        name: Resultado por item
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.numero,
                       coalesce(i.ncm, i.nbs) as ncm_nbs,
                       i.cclasstrib,
                       i.estado_item,
                       i.r_vbc,
                       i.r_p_red_aliq,
                       i.r_p_aliq_efet_cbs,
                       i.r_v_cbs,
                       coalesce(i.r_p_aliq_efet_ibs_uf, 0) + coalesce(i.r_p_aliq_efet_ibs_mun, 0) as p_aliq_efet_ibs,
                       i.r_v_ibs,
                       i.r_v_is,
                       i.r_total_item
                  from simulacao_item i
                 where i.simulacao_id = :P31_SIMULACAO_ID
                 order by i.numero
                ```
            pageItemsToSubmit: P31_SIMULACAO_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

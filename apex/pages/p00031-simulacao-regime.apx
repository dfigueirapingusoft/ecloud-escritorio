page 31 (
    name: Simulação - Regime Regular
    alias: SIMULACAO-REGIME
    title: Simulação - Regime Regular
    pageGroup: @simulacoes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <p>Preencha o cabeçalho e salve. Depois inclua os itens na grade e clique em <strong>Calcular</strong>.
            A calculadora da Reforma Tributária devolve o resultado por item; erros aparecem com a indicação do item e do campo.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Ações
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region simulacao (
        name: Cabeçalho da operação
        type: form
        source {
            location: localDatabase
            tableName: SIMULACAO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P31_SIMULACAO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @simulacao
            slot: regionBody
        }
        source {
            formRegion: @simulacao
            column: SIMULACAO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P31_REGIME (
        type: hidden
        layout {
            sequence: 20
            region: @simulacao
            slot: regionBody
        }
        source {
            formRegion: @simulacao
            column: REGIME
            dataType: varchar2
        }
        default {
            type: static
            staticValue: REGULAR
        }
    )

    pageItem P31_VERSAO_LEIAUTE (
        type: hidden
        layout {
            sequence: 30
            region: @simulacao
            slot: regionBody
        }
        source {
            formRegion: @simulacao
            column: VERSAO_LEIAUTE
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: pkg_rtc_config.valor('VERSAO_LEIAUTE_REGIME')
        }
    )

    pageItem P31_CLIENTE_ID (
        type: popupLov
        label {
            label: Cliente
            alignment: right
        }
        layout {
            sequence: 40
            region: @simulacao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @clientes-regular
        }
        source {
            formRegion: @simulacao
            column: CLIENTE_ID
            dataType: number
        }
    )

    pageItem P31_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: right
        }
        layout {
            sequence: 50
            region: @simulacao
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @simulacao
            column: DESCRICAO
            dataType: varchar2
        }
    )

    pageItem P31_DH_FATO_GERADOR (
        type: datePicker
        label {
            label: Data e hora do fato gerador
            alignment: right
        }
        layout {
            sequence: 60
            region: @simulacao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY HH24:MI
        }
        settings {
            showTime: true
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @simulacao
            column: DH_FATO_GERADOR
            dataType: timestampWithTimeZone
        }
        default {
            type: expression
            plsqlExpression: systimestamp
        }
    )

    pageItem P31_UF (
        type: selectList
        label {
            label: UF da operação
            alignment: right
        }
        layout {
            sequence: 70
            region: @simulacao
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @ufs
            displayNullValue: true
            nullDisplayValue: - Do cliente -
        }
        source {
            formRegion: @simulacao
            column: UF
            dataType: varchar2
        }
        help {
            inlineHelpText: Em branco: usa a UF do cliente.
        }
    )

    pageItem P31_MUNICIPIO_IBGE (
        type: popupLov
        label {
            label: Município da operação (IBGE)
            alignment: right
        }
        layout {
            sequence: 80
            region: @simulacao
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome || ' (' || codigo || ')' d, codigo r
                  from rtc_da_municipio
                 where sigla_uf = :P31_UF
                 order by nome
                ```
        }
        source {
            formRegion: @simulacao
            column: MUNICIPIO_IBGE
            dataType: number
        }
        help {
            inlineHelpText: Em branco: usa o município do cliente.
        }
        cascadingLov {
            parentItems: P31_UF
            parentRequired: false
        }
    )

    pageItem P31_TP_DOC (
        type: selectList
        label {
            label: Tipo de documento (opcional)
            alignment: right
        }
        layout {
            sequence: 90
            region: @simulacao
            slot: regionBody
            alignment: left

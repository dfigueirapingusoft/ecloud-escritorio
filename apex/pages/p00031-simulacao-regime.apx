    process preencher-do-cliente (
        name: Preencher dados do cliente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- UF e município da operação: quando em branco, usa os do cliente.
                if :P31_UF is null or :P31_MUNICIPIO_IBGE is null then
                    select coalesce(:P31_UF, c.uf),
                           coalesce(to_number(:P31_MUNICIPIO_IBGE), c.municipio_ibge)
                      into :P31_UF, :P31_MUNICIPIO_IBGE
                      from cliente c
                     where c.cliente_id = :P31_CLIENTE_ID;
                end if;
                ```
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 2982735526
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,CALCULAR
        }
    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @simulacao
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4330189854
        }
    )

    process process-form (
        name: Gravar cabeçalho
        type: formAutoRowProcessing
        formRegion: @simulacao
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1637871695
        }
    )

    process save-itens (
        name: Gravar itens
        type: interactiveGridAutoRowProcessing
        editableRegion: @itens
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 2371818652
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CALCULAR
        }
    )

    process calcular (
        name: Calcular na calculadora da RTC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Monta o JSON, chama a calculadora (PKG_RTC_HTTP com a Web Credential
                -- RTC_API_KEY), grava o log e o resultado por item. Erros da API viram
                -- mensagens amigáveis em SIMULACAO_ITEM_ERRO; a página mostra a situação.
                pkg_rtc_calc.calcular(:P31_SIMULACAO_ID);
                select status into :P31_STATUS from simulacao where simulacao_id = :P31_SIMULACAO_ID;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1227437305
        }
        successMessage {
            successMessage: Cálculo concluído. Situação: &P31_STATUS.
        }
        serverSideCondition {
            whenButtonPressed: @calcular
        }
    )

    process duplicar (
        name: Duplicar simulação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P31_SIMULACAO_ID := pkg_rtc_calc.duplicar(:P31_SIMULACAO_ID);
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 3474225989
        }
        successMessage {
            successMessage: Simulação duplicada. Você está editando a cópia.
        }
        serverSideCondition {
            whenButtonPressed: @duplicar
        }
    )

    branch voltar-lista (
        name: Voltar para a lista após excluir
        execution {
            sequence: 10
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 30
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch reabrir (
        name: Reabrir a simulação
        execution {
            sequence: 20
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 31
                items: {
                    P31_SIMULACAO_ID: &P31_SIMULACAO_ID.
                }
            }
        }
    )

)

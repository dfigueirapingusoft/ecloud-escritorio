    region resultado (
        name: Resultado por item
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.numero,
                       i.c_ativ_sn,
                       i.cclasstrib,
                       i.estado_item,
                       coalesce(i.motivo_estado_descricao, i.motivo_estado_codigo) as motivo,
                       i.r_v_rbsn,
                       i.r_tp_rbsn_descricao,
                       i.r_vbc,
                       i.r_p_cbs_sn,
                       i.r_v_cbs,
                       i.r_p_ibs_sn,
                       i.r_v_ibs,
                       i.r_v_is,
                       i.r_total_item
                  from simulacao_item i
                 where i.simulacao_id = :P32_SIMULACAO_ID
                 order by i.numero
                ```
            pageItemsToSubmit: P32_SIMULACAO_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nenhum registro.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P32_STATUS is not null and :P32_STATUS <> 'RASCUNHO'
        }


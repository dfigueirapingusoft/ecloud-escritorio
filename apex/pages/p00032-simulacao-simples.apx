        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_SIMULACAO_ID
        }
    )

    button calcular (
        buttonName: CALCULAR
        label: Calcular
        layout {
            sequence: 60
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            icon: fa-calculator
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_SIMULACAO_ID
        }
    )

    process preencher-do-cliente (
        name: Preencher dados do cliente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- CRT: quando em branco, usa o do cliente.
                if :P32_CRT is null then
                    select c.crt
                      into :P32_CRT
                      from cliente c
                     where c.cliente_id = :P32_CLIENTE_ID;
                end if;
                ```
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 1595885815
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,CALCULAR
        }
    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @simulacao
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2601698724
        }
    )

    process process-form (
        name: Gravar cabeçalho
        type: formAutoRowProcessing
        formRegion: @simulacao
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4205265397
        }
    )

    process save-itens (
        name: Gravar itens
        type: interactiveGridAutoRowProcessing
        editableRegion: @itens
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4368885030
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CALCULAR
        }
    )

    process calcular (
        name: Calcular na calculadora da RTC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Monta o JSON, chama a calculadora (PKG_RTC_HTTP com a Web Credential
                -- RTC_API_KEY), grava o log e o resultado por item. Erros da API viram
                -- mensagens amigáveis em SIMULACAO_ITEM_ERRO; a página mostra a situação.
                pkg_rtc_calc.calcular(:P32_SIMULACAO_ID);
                select status into :P32_STATUS from simulacao where simulacao_id = :P32_SIMULACAO_ID;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 4469138783
        }
        successMessage {
            successMessage: Cálculo concluído. Situação: &P32_STATUS.
        }
        serverSideCondition {
            whenButtonPressed: @calcular
        }
    )

    process duplicar (
        name: Duplicar simulação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P32_SIMULACAO_ID := pkg_rtc_calc.duplicar(:P32_SIMULACAO_ID);
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 4189903888
        }
        successMessage {
            successMessage: Simulação duplicada. Você está editando a cópia.
        }
        serverSideCondition {
            whenButtonPressed: @duplicar
        }
    )

    branch voltar-lista (
        name: Voltar para a lista após excluir
        execution {
            sequence: 10
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 30
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch reabrir (
        name: Reabrir a simulação
        execution {
            sequence: 20
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 32
                items: {
                    P32_SIMULACAO_ID: &P32_SIMULACAO_ID.
                }
            }
        }
    )

)

                formatMask: FML999G999G999G990D00
            }
        )

        column R_V_IS (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Imposto Seletivo
                alignment: end
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G990D00
            }
        )

        column R_TOTAL_ITEM (
            reportColumnQueryId: 14

    region salve-antes (
        name: Itens
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Salve o cabeçalho para incluir os itens da operação.</p>
                ```
        }
        layout {
            sequence: 21
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P32_SIMULACAO_ID
        }
    )

    region totais (
        name: Totais
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select qtd_itens,
                       qtd_itens_pendentes,
                       tot_receita_bruta_sn,
                       tot_base_calculo,
                       tot_cbs,
                       tot_ibs,
                       tot_is,
                       tot_tributos,
                       versao_app_calc || ' / ' || versao_db_calc as versao_calculadora,
                       cast(processada_em as date) as processada_em
                  from simulacao
                 where simulacao_id = :P32_SIMULACAO_ID
                ```
            pageItemsToSubmit: P32_SIMULACAO_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nenhum registro.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P32_STATUS is not null and :P32_STATUS <> 'RASCUNHO'
        }

        column QTD_ITENS (

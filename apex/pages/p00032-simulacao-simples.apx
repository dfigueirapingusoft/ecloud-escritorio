page 32 (
    name: Simulação - Simples Nacional
    alias: SIMULACAO-SIMPLES
    title: Simulação - Simples Nacional
    pageGroup: @simulacoes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <p>Preencha o cabeçalho e salve. Depois inclua os itens na grade e clique em <strong>Calcular</strong>.
            A calculadora da Reforma Tributária devolve o resultado por item; erros aparecem com a indicação do item e do campo.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Ações
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region simulacao (
        name: Cabeçalho da operação
        type: form
        source {
            location: localDatabase
            tableName: SIMULACAO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P32_SIMULACAO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @simulacao
            slot: regionBody
        }
        source {
            formRegion: @simulacao
            column: SIMULACAO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P32_REGIME (
        type: hidden
        layout {
            sequence: 20
            region: @simulacao
            slot: regionBody
        }
        source {
            formRegion: @simulacao
            column: REGIME
            dataType: varchar2
        }
        default {
            type: static
            staticValue: SIMPLES
        }
    )

    pageItem P32_VERSAO_LEIAUTE (
        type: hidden
        layout {
            sequence: 30
            region: @simulacao
            slot: regionBody
        }
        source {
            formRegion: @simulacao
            column: VERSAO_LEIAUTE
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: pkg_rtc_config.valor('VERSAO_LEIAUTE_SIMPLES')
        }
    )

    pageItem P32_CLIENTE_ID (
        type: popupLov
        label {
            label: Cliente
            alignment: right
        }
        layout {
            sequence: 40
            region: @simulacao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @clientes-simples
        }
        source {
            formRegion: @simulacao
            column: CLIENTE_ID
            dataType: number
        }
    )

    pageItem P32_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: right
        }
        layout {
            sequence: 50
            region: @simulacao
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @simulacao
            column: DESCRICAO
            dataType: varchar2
        }
    )

    pageItem P32_DATA_FATO_GERADOR (
        type: datePicker
        label {
            label: Data do fato gerador
            alignment: right
        }
        layout {
            sequence: 60
            region: @simulacao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @simulacao
            column: DATA_FATO_GERADOR
            dataType: date
        }
        default {
            type: expression
            plsqlExpression: trunc(current_date)
        }
    )

    pageItem P32_TP_DOC (
        type: selectList
        label {
            label: Tipo de documento
            alignment: right
        }
        layout {
            sequence: 70
            region: @simulacao
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipos-dfe
            displayNullValue: true
            nullDisplayValue: - Selecione -
        }
        source {
            formRegion: @simulacao
            column: TP_DOC
            dataType: number
        }
    )

    pageItem P32_CRT (
        type: selectList
        label {
            label: CRT
            alignment: right
        }
        layout {
            sequence: 80
            region: @simulacao
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @crt
            displayNullValue: true
            nullDisplayValue: - Do cliente -
        }
        source {
            formRegion: @simulacao
            column: CRT
            dataType: varchar2
        }
        help {
            inlineHelpText: Em branco: usa o CRT do cliente.
        }
    )

    pageItem P32_TP_REGIME_IBSCBS (
        type: selectList
        label {
            label: Regime de apuração IBS/CBS
            alignment: right
        }
        layout {
            sequence: 90
            region: @simulacao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @tp-regime-ibscbs
            displayNullValue: true
            nullDisplayValue: - Não informado -
        }
        source {
            formRegion: @simulacao
            column: TP_REGIME_IBSCBS
            dataType: varchar2
        }
    )

    pageItem P32_TP_ENTE_GOV (
        type: selectList
        label {
            label: Compra governamental: ente
            alignment: right
        }
        layout {
            sequence: 100
            region: @simulacao
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @tp-ente-gov
            displayNullValue: true
            nullDisplayValue: - Não é compra governamental -
        }
        source {
            formRegion: @simulacao
            column: TP_ENTE_GOV
            dataType: number
        }
    )

    pageItem P32_STATUS (
        type: displayOnly
        label {
            label: Situação
            alignment: right
        }
        layout {
            sequence: 110
            region: @simulacao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @simulacao
            column: STATUS
            dataType: varchar2
            queryOnly: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_SIMULACAO_ID
        }
    )

    pageItem P32_MENSAGEM_ERRO (
        type: displayOnly
        label {
            label: Mensagem da calculadora
            alignment: right
        }
        layout {
            sequence: 120
            region: @simulacao
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @simulacao
            column: MENSAGEM_ERRO
            dataType: varchar2
            queryOnly: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_MENSAGEM_ERRO
        }
    )

    region itens (
        name: Itens
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SIMULACAO_ITEM
            whereClause: simulacao_id = :P32_SIMULACAO_ID
            orderByClause: numero
            pageItemsToSubmit: P32_SIMULACAO_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3346027955
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_SIMULACAO_ID
        }

        savedReport 590568295 (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 50
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @ITEM_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @SIMULACAO_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @NUMERO
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @C_ATIV_SN
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @CCLASSTRIB
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @NCM
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @NBS
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @BASE_CALCULO
                layout {
                    sequence: 8
                }
            )
            displayColumn (
                column: @VALOR_IS
                layout {
                    sequence: 9
                }
            )
            displayColumn (
                column: @P_IBS_SN
                layout {
                    sequence: 10
                }
            )
            displayColumn (
                column: @P_CBS_SN
                layout {
                    sequence: 11
                }
            )

        )



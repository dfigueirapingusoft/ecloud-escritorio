page 101 (
    name: Anúncio
    alias: ANUNCIO
    title: Anúncio
    pageGroup: @administracao
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    security {
        authorizationScheme: @admin-plataforma
    }

    region buttons (
        name: Botões
        type: staticContent
        layout {
            sequence: 30
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region anuncio (
        name: Anúncio
        type: form
        source {
            location: localDatabase
            tableName: ANUNCIO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region imagem (
        name: Imagem
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Imagem atual (lida do Worker de mídia) e estatística dos últimos 30 dias.
                declare
                    l_url   varchar2(2000);
                    l_html  varchar2(4000);
                begin
                    if :P101_ANUNCIO_ID is null then
                        return '<p class="u-text-secondary">Grave o anúncio junto com a imagem ou envie a imagem depois.</p>';
                    end if;
                    l_url := pkg_ecloud_anuncio.imagem_url(:P101_ANUNCIO_ID);
                    l_html := case
                                  when l_url is not null then
                                      '<img class="ec-ad-preview" alt="Imagem atual do anúncio" src="'
                                      || apex_escape.html_attribute(l_url) || '">'
                                  else '<p class="u-text-secondary">Sem imagem.</p>'
                              end;
                    return l_html || '<p class="u-text-secondary">'
                        || apex_escape.html(pkg_ecloud_anuncio.estatistica_rotulo(:P101_ANUNCIO_ID, 30))
                        || ' nos últimos 30 dias.</p>';
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P101_ANUNCIO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @anuncio
            slot: regionBody
        }
        source {
            formRegion: @anuncio
            column: ANUNCIO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P101_IMAGEM (
        type: fileUpload
        label {
            label: Nova imagem (PNG, JPEG, WebP ou GIF, até 2 MiB)
            alignment: right
        }
        layout {
            sequence: 20
            region: @imagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        display {
            displayAs: inlineDropzone
            dropzoneTitle: Arraste a imagem do anúncio
            dropzoneDesc: ou clique para escolher o arquivo
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
            fileTypes: image/png,image/jpeg,image/webp,image/gif
            maxFileSize: 2048
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P101_ANUNCIO_ID
        }
    )

    button remover-imagem (
        buttonName: REMOVER_IMAGEM
        label: Remover imagem
        layout {
            sequence: 10
            region: @imagem
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Remover a imagem deste anúncio? O arquivo também é apagado do armazenamento.
            style: danger
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from anuncio where anuncio_id = :P101_ANUNCIO_ID and imagem_chave is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P101_ANUNCIO_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P101_ANUNCIO_ID
        }
    )

    validation periodo (
        name: Fim depois do início
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return :P101_INICIO_EM is null or :P101_FIM_EM is null
                    or to_date(:P101_FIM_EM, 'DD/MM/YYYY') >= to_date(:P101_INICIO_EM, 'DD/MM/YYYY');
                ```
        }
        error {
            errorMessage: O fim precisa ser igual ou posterior ao início.
            associatedItem: @P101_FIM_EM
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation url-https (
        name: Link com http ou https
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return :P101_BOTAO_URL is null
                    or lower(:P101_BOTAO_URL) like 'https://%'
                    or lower(:P101_BOTAO_URL) like 'http://%';
                ```
        }
        error {
            errorMessage: Informe o endereço completo, começando com https://.
            associatedItem: @P101_BOTAO_URL
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancelar diálogo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @anuncio
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4598601618
        }
    )

    process apagar-imagem-antes-de-excluir (
        name: Apagar a imagem do R2 antes de excluir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Sem isto o arquivo ficaria órfão no bucket depois do DELETE.
                pkg_ecloud_anuncio.remover_imagem(:P101_ANUNCIO_ID);
                ```
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 6011953177
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
    )

    process process-form (
        name: Gravar formulário
        type: formAutoRowProcessing
        formRegion: @anuncio
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2690404090
        }
    )

    process salvar-imagem (
        name: Enviar a imagem ao Worker de mídia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- O arquivo está em APEX_APPLICATION_TEMP_FILES até o fim desta requisição.
                -- O pacote valida tipo e tamanho, envia ao R2 pelo Worker (PKG_RTC_HTTP,
                -- com log) e apaga a imagem anterior.
                pkg_ecloud_anuncio.salvar_imagem(
                    p_anuncio_id     => :P101_ANUNCIO_ID,
                    p_temp_file_name => :P101_IMAGEM);
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 5989536573
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE') and :P101_IMAGEM is not null
        }
    )

    process remover-imagem (
        name: Remover imagem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_ecloud_anuncio.remover_imagem(:P101_ANUNCIO_ID);
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 4939828323
        }
        successMessage {
            successMessage: Imagem removida.
        }
        serverSideCondition {
            whenButtonPressed: @remover-imagem
        }
    )

    process close-dialog (
        name: Fechar diálogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 4201558812
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)

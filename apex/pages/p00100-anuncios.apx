page 100 (
    name: Anúncios
    alias: ANUNCIOS
    title: Anúncios
    pageGroup: @administracao
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @admin-plataforma
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region aviso-midia (
        name: Imagens sem Worker de mídia
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ec-notice ec-notice--warning"><span class="fa fa-exclamation-triangle" aria-hidden="true"></span>
                <p>O endereço do Worker de mídia (<code>MIDIA_BASE_URL</code>) ainda não foi configurado: os anúncios
                aparecem sem imagem e o envio de imagens fica indisponível. Veja <code>cloudflare/midia/README.md</code>.</p></div>
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: pkg_rtc_config.valor(pkg_rtc_config.c_midia_base_url, false) is null
        }
    )

    region anuncios (
        name: Anúncios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select anuncio_id,
                       patrocinador,
                       titulo,
                       case
                           when ativo = 'N'                  then 'Inativo'
                           when inicio_em > trunc(sysdate)   then 'Agendado'
                           when fim_em < trunc(sysdate)      then 'Encerrado'
                           else 'No ar'
                       end as situacao,
                       inicio_em,
                       fim_em,
                       ordem,
                       exibir_login,
                       exibir_ofertas,
                       case when imagem_chave is not null then 'Sim' else 'Não' end as imagem,
                       pkg_ecloud_anuncio.estatistica_rotulo(anuncio_id, 30) as ultimos_30_dias
                  from anuncio
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 101
                items: {
                    P101_ANUNCIO_ID: \#ANUNCIO_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum anúncio cadastrado.
        }
        actionsMenu {
            subscription: false
        }

        column ANUNCIO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
        )

        column PATROCINADOR (
            type: plainText
            heading {
                heading: Patrocinador
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
        )

        column TITULO (
            type: plainText
            heading {
                heading: Título
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situação
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
        )

        column INICIO_EM (
            type: plainText
            heading {
                heading: Início
            }
            layout {
                sequence: 5
            }
            source {
                dataType: date
            }
        )

        column FIM_EM (
            type: plainText
            heading {
                heading: Fim
            }
            layout {
                sequence: 6
            }
            source {
                dataType: date
            }
        )

        column ORDEM (
            type: plainText
            heading {
                heading: Ordem
            }
            layout {
                sequence: 7
            }
            source {
                dataType: number
            }
        )

        column EXIBIR_LOGIN (
            type: plainTextBasedOnLov
            heading {
                heading: No login
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
        )

        column EXIBIR_OFERTAS (
            type: plainTextBasedOnLov
            heading {
                heading: Nas ofertas
            }
            lov {
                lov: @sim-nao
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
        )

        column IMAGEM (
            type: plainText
            heading {
                heading: Imagem
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
        )

        column ULTIMOS_30_DIAS (
            type: plainText
            heading {
                heading: Últimos 30 dias
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
        )

        savedReport 9748382148 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PATROCINADOR (
                sequence: 1
            )

            displayColumn TITULO (
                sequence: 2
            )

            displayColumn SITUACAO (
                sequence: 3
            )

            displayColumn INICIO_EM (
                sequence: 4
            )

            displayColumn FIM_EM (
                sequence: 5
            )

            displayColumn ORDEM (
                sequence: 6
            )

            displayColumn EXIBIR_LOGIN (
                sequence: 7
            )

            displayColumn EXIBIR_OFERTAS (
                sequence: 8
            )

            displayColumn IMAGEM (
                sequence: 9
            )

            displayColumn ULTIMOS_30_DIAS (
                sequence: 10
            )

            sort (
                column: ORDEM
                sort {
                    sequence: 1
                }
            )

        )
    )

    button create (
        buttonName: CREATE
        label: Criar anúncio
        layout {
            sequence: 10
            region: @anuncios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 101
                clearCache: 101
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-after-dialog (
        name: Atualizar após fechar o diálogo
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @anuncios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @anuncios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

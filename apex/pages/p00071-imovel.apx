    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_IMOVEL_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_IMOVEL_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P71_IMOVEL_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    validation caepf-14-digitos (
        name: CAEPF com 14 dígitos
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return :P71_CAEPF is null or regexp_like(regexp_replace(:P71_CAEPF, '[^0-9]', ''), '^[0-9]{14}$');
        }
        error {
            errorMessage: O CAEPF tem 14 dígitos (999.999.999/999-99). Se o produtor não tiver CAEPF, deixe o campo em branco.
            associatedItem: @P71_CAEPF
        }
        execution {
            sequence: 15
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation cad-itr (
        name: CIB/NIRF com 8 dígitos
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return :P71_CAD_ITR is null or pkg_rural_cadastro.cad_itr_valido(:P71_CAD_ITR);
        }
        error {
            errorMessage: O CIB/NIRF deve ter 8 dígitos.
            associatedItem: @P71_CAD_ITR
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation municipio-da-uf (
        name: Município pertence à UF
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return pkg_ecloud_util.municipio_valido(:P71_UF, to_number(:P71_MUNICIPIO_IBGE));
        }
        error {
            errorMessage: O município informado não pertence à UF.
            associatedItem: @P71_MUNICIPIO_IBGE
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation participacao (
        name: Participação entre 0 e 100%
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return to_number(:P71_PARTICIPACAO_PCT) > 0 and to_number(:P71_PARTICIPACAO_PCT) <= 100;
        }
        error {
            errorMessage: A participação deve ser maior que 0 e no máximo 100%.
            associatedItem: @P71_PARTICIPACAO_PCT
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancelar diálogo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process initialize-form (

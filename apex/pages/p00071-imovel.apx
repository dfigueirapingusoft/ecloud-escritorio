page 71 (
    name: Imóvel rural
    alias: IMOVEL
    title: Imóvel rural
    pageGroup: @rural
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
        width: 900
    }
    region buttons (
        name: Botões
        type: staticContent
        layout {
            sequence: 90
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region imovel (
        name: Imóvel
        type: form
        source {
            location: localDatabase
            tableName: IMOVEL_RURAL
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region contrapartes (
        name: Contrapartes (condôminos, arrendadores, parceiros, comodantes)
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: IMOVEL_CONTRAPARTE
            whereClause: imovel_id = :P71_IMOVEL_ID
            orderByClause: nome
            pageItemsToSubmit: P71_IMOVEL_ID
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        advanced {
            savedReportMappingIdentifier: 8618814487
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_IMOVEL_ID
        }
        savedReport 358004774 (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 50
            }
            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @CONTRAPARTE_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @IMOVEL_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @TIPO_CONTRAPARTE
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @TIPO_PESSOA
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @DOCUMENTO
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @NOME
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @PERCENTUAL
                layout {
                    sequence: 7
                }
            )
        )
        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )
        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )
        column CONTRAPARTE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: CONTRAPARTE_ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )
        column IMOVEL_ID (
            type: hidden
            heading {
                heading: Imóvel
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IMOVEL_ID
                dataType: number
            }
            default {
                type: item
                item: P71_IMOVEL_ID
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )
        column TIPO_CONTRAPARTE (
            type: selectList
            heading {
                heading: Tipo
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @tipo-contraparte
                displayNullValue: true
            }
            source {
                databaseColumn: TIPO_CONTRAPARTE
                dataType: varchar2
            }
            columnFilter {
                lovType: none
            }
        )
        column TIPO_PESSOA (
            type: selectList
            heading {
                heading: Pessoa
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @tipos-pessoa
                displayNullValue: true
            }
            source {
                databaseColumn: TIPO_PESSOA
                dataType: varchar2
            }
            default {
                type: static
                staticValue: F
            }
            columnFilter {
                lovType: none
            }
        )
        column DOCUMENTO (
            type: textField
            heading {
                heading: CPF/CNPJ
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
                maxLength: 18
            }
            source {
                databaseColumn: DOCUMENTO
                dataType: varchar2
            }
        )
        column NOME (
            type: textField
            heading {
                heading: Nome
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
                maxLength: 50
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
        )
        column PERCENTUAL (
            type: numberField
            heading {
                heading: Participação (%)
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: decimal
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: 990D00
            }
            source {
                databaseColumn: PERCENTUAL
                dataType: number
            }
        )
    )


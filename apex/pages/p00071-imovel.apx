        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @imovel
            column: MUNICIPIO_IBGE
            dataType: number
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome || ' (' || codigo || ')' d, codigo r
                  from rtc_da_municipio
                 where sigla_uf = :P71_UF
                 order by nome
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P71_UF
        }
    )


        savedReport 366199394 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }
            displayColumn DATA_LANCAMENTO (
                sequence: 1
            )
            displayColumn CONTA (
                sequence: 2
            )
            displayColumn CATEGORIA (
                sequence: 3
            )
            displayColumn CATEGORIA_GRUPO (
                sequence: 4
            )
            displayColumn TIPO_LANC (
                sequence: 5
            )
            displayColumn NATUREZA (
                sequence: 6
            )
            displayColumn VALOR (
                sequence: 7
            )
            displayColumn VALOR_SINAL (
                sequence: 8
            )
            displayColumn HISTORICO (
                sequence: 9
            )
            displayColumn IMOVEL (
                sequence: 10
            )
            displayColumn CENTRO_CUSTO_NOME (
                sequence: 11
            )
            displayColumn TIPO_DOC (
                sequence: 12
            )
            displayColumn NUM_DOC (
                sequence: 13
            )
            displayColumn PARTIC_NOME (
                sequence: 14

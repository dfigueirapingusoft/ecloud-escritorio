        )
    )

    button lancar (
        buttonName: LANCAR
        label: Novo lançamento
        layout {
            sequence: 10
            region: @acoes
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            icon: fa-plus
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
                clearCache: 81
                items: {
                    P81_CLIENTE_ID: &P80_CLIENTE_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    button transferir (
        buttonName: TRANSFERIR
        label: Transferência entre contas
        layout {
            sequence: 20
            region: @acoes
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            icon: fa-exchange
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 82
                clearCache: 82
                items: {
                    P82_CLIENTE_ID: &P80_CLIENTE_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    dynamicAction refresh-after-dialog (
        name: Atualizar após fechar o diálogo
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lancamentos
        }
        action refresh-lancamentos (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lancamentos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-resumo (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumo
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )
    )

    dynamicAction trocar-filtro (
        name: Recarregar ao trocar o filtro
        execution {
            sequence: 50
        }
        when {
            event: change
            selectionType: items
            items: P80_CLIENTE_ID
        }
        action native-submit (
            action: submitPage
            settings {
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process carregar-produtor (
        name: Carregar o produtor escolhido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- O produtor escolhido em qualquer página do módulo fica em F_PRODUTOR_ID.
                if :F_PRODUTOR_ID is not null then
                    if :P80_CLIENTE_ID is null or :P80_CLIENTE_ID <> :F_PRODUTOR_ID then
                        :P80_CONTA_ID := null;
                    end if;
                    :P80_CLIENTE_ID := :F_PRODUTOR_ID;
                end if;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 7476399784
        }
    )

    process guardar-produtor (
        name: Guardar o produtor escolhido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :F_PRODUTOR_ID is null or :F_PRODUTOR_ID <> :P80_CLIENTE_ID then
                    :P80_CONTA_ID := null;
                end if;
                :F_PRODUTOR_ID := :P80_CLIENTE_ID;
                ```
        }
        execution {
            sequence: 1
        }
        advanced {
            executionMappingIdentifier: 8051632948
        }
    )

    branch recarregar (
        name: Recarregar a página
        execution {
            sequence: 99
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 80
            }
        }
    )
)

page 80 (
    name: Livro caixa
    alias: LIVRO-CAIXA
    title: Livro caixa
    pageGroup: @rural
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <p>Entradas e saídas do produtor por conta. Lançamentos conciliados com o extrato não podem ser alterados; desfaça a conciliação antes.</p>
            ```
    }
    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
        }
    )

    pageItem P80_CLIENTE_ID (
        type: selectList
        label {
            label: Produtor rural
            alignment: right
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            columnSpan: 5
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @produtores
            displayNullValue: true
            nullDisplayValue: - Selecione o produtor -
        }
        sessionState {
            storage: session
        }
    )

    pageItem P80_DATA_INICIO (
        type: datePicker
        label {
            label: De
            alignment: right
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: trunc(current_date, 'YYYY')
        }
        sessionState {
            storage: session
        }
    )

    pageItem P80_DATA_FIM (
        type: datePicker
        label {
            label: Até
            alignment: right
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: trunc(current_date)
        }
        sessionState {
            storage: session
        }
    )

    pageItem P80_CONTA_ID (
        type: selectList
        label {
            label: Conta
            alignment: right
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select lpad(cod_conta, 3, '0') || ' - ' || apelido d, conta_id r
                  from conta_bancaria
                 where cliente_id = :P80_CLIENTE_ID
                   and ativo = 'S'
                 order by cod_conta
                ```
            displayNullValue: true
            nullDisplayValue: - Todas -
        }
        sessionState {
            storage: session
        }
        cascadingLov {
            parentItems: P80_CLIENTE_ID
        }
    )

    button aplicar (
        buttonName: APLICAR
        label: Aplicar filtros
        layout {
            sequence: 10
            region: @filtros
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    region sem-produtor (
        name: Selecione o produtor
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Selecione o produtor rural para ver os dados. Produtores são clientes pessoa física, cadastrados em Clientes.</p>
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P80_CLIENTE_ID
        }
    )

    region acoes (
        name: Ações
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P80_CLIENTE_ID
        }
    )

    region resumo (
        name: Resumo do período
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                     select sum(case l.natureza when 'E' then l.valor else 0 end) as entradas,
                            sum(case l.natureza when 'S' then l.valor else 0 end) as saidas,
                            sum(l.valor_sinal) as saldo_periodo,
                            sum(case when l.tipo_lanc in ('1', '3') then l.valor else 0 end) as receita_rural,
                            sum(case when l.tipo_lanc = '2' then l.valor else 0 end) as despesa_rural,
                            count(case when l.status_conciliacao = 'PENDENTE' then 1 end) as a_conciliar
                       from vw_livro_caixa l
                      where l.cliente_id = :P80_CLIENTE_ID
                and l.data_lancamento >= to_date(:P80_DATA_INICIO, 'DD/MM/YYYY')
                and l.data_lancamento <  to_date(:P80_DATA_FIM, 'DD/MM/YYYY') + 1
                and (:P80_CONTA_ID is null or l.conta_id = :P80_CONTA_ID)
                ```
            pageItemsToSubmit: P80_CLIENTE_ID,P80_DATA_INICIO,P80_DATA_FIM,P80_CONTA_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nenhum registro.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P80_CLIENTE_ID
        }
        column ENTRADAS (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Entradas
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column SAIDAS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Saídas
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column SALDO_PERIODO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Entradas - saídas
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column RECEITA_RURAL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Receita rural (LCDPR)
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column DESPESA_RURAL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Despesa rural (LCDPR)
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )
        column A_CONCILIAR (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: A conciliar
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
        )
    )

    region lancamentos (
        name: Lançamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                     select l.lancamento_id,
                            l.data_lancamento,
                            lpad(l.cod_conta, 3, '0') || ' - ' || l.conta_apelido as conta,
                            l.categoria_codigo || ' - ' || l.categoria_nome as categoria,
                            l.categoria_grupo,
                            l.tipo_lanc,
                            l.natureza,
                            l.valor,
                            l.valor_sinal,
                            l.historico,
                            case when l.imovel_id is null then '000 - Comum'
                                 else lpad(l.cod_imovel, 3, '0') || ' - ' || l.imovel_nome end as imovel,
                            l.centro_custo_nome,
                            l.tipo_doc,
                            l.num_doc,
                            l.partic_nome,
                            pkg_rural_cadastro.formatar_documento(l.partic_documento) as partic_documento,
                            l.origem,
                            l.status_conciliacao,
                            case when l.transferencia_id is not null then 'S' else 'N' end as transferencia
                       from vw_livro_caixa l
                      where l.cliente_id = :P80_CLIENTE_ID
                and l.data_lancamento >= to_date(:P80_DATA_INICIO, 'DD/MM/YYYY')
                and l.data_lancamento <  to_date(:P80_DATA_FIM, 'DD/MM/YYYY') + 1
                and (:P80_CONTA_ID is null or l.conta_id = :P80_CONTA_ID)
                ```
            pageItemsToSubmit: P80_CLIENTE_ID,P80_DATA_INICIO,P80_DATA_FIM,P80_CONTA_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 81
                items: {
                    P81_LANCAMENTO_ID: \#LANCAMENTO_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Abrir"><span class="fa fa-edit" aria-hidden="true" title="Abrir"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        actionsMenu {
            subscription: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P80_CLIENTE_ID
        }
        column LANCAMENTO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
        )
        column DATA_LANCAMENTO (
            type: plainText
            heading {
                heading: Data
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
            source {
                dataType: date

page 11 (
    name: Escritório
    alias: ESCRITORIO
    title: Escritório
    pageGroup: @administracao
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    security {
        authorizationScheme: @admin-plataforma
    }

    region buttons (
        name: Botões
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region escritorio (
        name: Escritório
        type: form
        source {
            location: localDatabase
            tableName: ESCRITORIO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
    )

    region assinatura (
        name: Assinatura
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Situação do escritório e da assinatura (docs/07-autocadastro-assinatura.md).
                declare
                    l_html varchar2(4000);
                begin
                    for e in (select e.situacao, e.teste_ate, e.origem_cadastro,
                                     a.situacao situacao_assinatura, a.periodo_fim, a.plano_id, a.ultimo_erro,
                                     (select count(*) from assinatura_fatura f
                                       where f.escritorio_id = e.escritorio_id
                                         and f.situacao in ('PENDENTE', 'VENCIDA')) abertas
                                from escritorio e
                                left join assinatura a on a.escritorio_id = e.escritorio_id and a.situacao <> 'CANCELADA'
                               where e.escritorio_id = :P11_ESCRITORIO_ID)
                    loop
                        l_html := '<dl class="ecl-assinatura-info">'
                            || '<div><dt>Situação</dt><dd>' || apex_escape.html(initcap(e.situacao)) || '</dd></div>'
                            || '<div><dt>Origem</dt><dd>' || case e.origem_cadastro when 'AUTOCADASTRO' then 'Autocadastro' else 'Plataforma' end || '</dd></div>'
                            || case when e.situacao = 'TESTE' then '<div><dt>Teste até</dt><dd>' || to_char(e.teste_ate, 'DD/MM/YYYY') || '</dd></div>' end
                            || case when e.plano_id is not null then
                                   '<div><dt>Plano</dt><dd>' || apex_escape.html(pkg_ecloud_assinatura.rotulo_plano(e.plano_id)) || '</dd></div>'
                                   || '<div><dt>Assinatura</dt><dd>' || apex_escape.html(initcap(e.situacao_assinatura))
                                   || ' até ' || to_char(e.periodo_fim - 1, 'DD/MM/YYYY') || '</dd></div>'
                                   || '<div><dt>Faturas em aberto</dt><dd>' || e.abertas || '</dd></div>'
                               else '<div><dt>Assinatura</dt><dd>Sem cobrança (escritório não é cobrado)</dd></div>' end
                            || '</dl>'
                            || case when e.ultimo_erro is not null then
                                   '<p class="u-danger-text">Último erro da cobrança: ' || apex_escape.html(e.ultimo_erro) || '</p>' end;
                    end loop;
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ESCRITORIO_ID
        }
    )

    pageItem P11_ESCRITORIO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @escritorio
            slot: regionBody
        }
        source {
            formRegion: @escritorio
            column: ESCRITORIO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_CNPJ (
        type: textField
        label {
            label: CNPJ
            alignment: right
        }
        layout {
            sequence: 20
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
            maxLength: 18
        }
        source {
            formRegion: @escritorio
            column: CNPJ
            dataType: varchar2
        }
        help {
            inlineHelpText: Numérico ou alfanumérico; a máscara é opcional.
        }
    )

    pageItem P11_RAZAO_SOCIAL (
        type: textField
        label {
            label: Razão social
            alignment: right
        }
        layout {
            sequence: 30
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
        source {
            formRegion: @escritorio
            column: RAZAO_SOCIAL
            dataType: varchar2
        }
    )

    pageItem P11_NOME_FANTASIA (
        type: textField
        label {
            label: Nome fantasia
            alignment: right
        }
        layout {
            sequence: 40
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            maxLength: 150
        }
        source {
            formRegion: @escritorio
            column: NOME_FANTASIA
            dataType: varchar2
        }
    )

    pageItem P11_UF (
        type: selectList
        label {
            label: UF
            alignment: right
        }
        layout {
            sequence: 50
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @ufs
            displayNullValue: true
            nullDisplayValue: - Selecione -
        }
        source {
            formRegion: @escritorio
            column: UF
            dataType: varchar2
        }
    )

    pageItem P11_MUNICIPIO_IBGE (
        type: popupLov
        label {
            label: Município (IBGE)
            alignment: right
        }
        layout {
            sequence: 60
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome || ' (' || codigo || ')' d, codigo r
                  from rtc_da_municipio
                 where sigla_uf = :P11_UF
                 order by nome
                ```
        }
        source {
            formRegion: @escritorio
            column: MUNICIPIO_IBGE
            dataType: number
        }
        cascadingLov {
            parentItems: P11_UF
        }
    )

    pageItem P11_EMAIL (
        type: textField
        label {
            label: E-mail
            alignment: right
        }
        layout {
            sequence: 70
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @escritorio
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P11_TELEFONE (
        type: textField
        label {
            label: Telefone
            alignment: right
        }
        layout {
            sequence: 80
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @escritorio
            column: TELEFONE
            dataType: varchar2
        }
    )

    pageItem P11_ATIVO (
        type: switch
        label {
            label: Ativo
            alignment: right
        }
        layout {
            sequence: 90
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        settings {
            useDefaults: false
            onValue: S
            offValue: N
        }
        source {
            formRegion: @escritorio
            column: ATIVO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: S
        }
    )

    pageItem P11_PLANO_INICIAR (
        type: selectList
        label {
            label: Plano da assinatura
            alignment: right
        }
        layout {
            sequence: 10
            region: @assinatura
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pkg_ecloud_assinatura.rotulo_plano(plano_id) d, plano_id r
                  from plano
                 where ativo = 'S'
                 order by ordem
                ```
            displayNullValue: true
            nullDisplayValue: - Escolha o plano -
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery: select null from assinatura where escritorio_id = :P11_ESCRITORIO_ID and situacao <> 'CANCELADA'
        }
        help {
            inlineHelpText: Começa um período de teste e passa a cobrar este escritório pela Stone.
        }
    )

    pageItem P11_LIBERAR_ATE (
        type: datePicker
        label {
            label: Liberar o acesso até
            alignment: right
        }
        layout {
            sequence: 20
            region: @assinatura
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select null from assinatura where escritorio_id = :P11_ESCRITORIO_ID and situacao <> 'CANCELADA'
        }
        help {
            inlineHelpText: Cancela a fatura em aberto e deixa o escritório usar o app até esta data; a próxima fatura sai perto dela.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ESCRITORIO_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_ESCRITORIO_ID
        }
    )

    button iniciar (
        buttonName: INICIAR
        label: Iniciar assinatura
        layout {
            sequence: 10
            region: @assinatura
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Iniciar a cobrança deste escritório? Ele entra em teste e recebe a fatura perto do fim do teste.
            style: warning
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery: select null from assinatura where escritorio_id = :P11_ESCRITORIO_ID and situacao <> 'CANCELADA'
        }
    )

    button liberar (
        buttonName: LIBERAR
        label: Liberar acesso
        layout {
            sequence: 20
            region: @assinatura
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Liberar o acesso até a data informada? A fatura em aberto é cancelada na Stone.
            style: warning
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select null from assinatura where escritorio_id = :P11_ESCRITORIO_ID and situacao <> 'CANCELADA'
        }
    )

    button cancelar-escritorio (
        buttonName: CANCELAR_ESCRITORIO
        label: Cancelar escritório
        layout {
            sequence: 30
            region: @assinatura
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Cancelar este escritório? O login dele fica barrado e as faturas em aberto são canceladas. Nenhum dado é apagado.
            style: danger
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select null from escritorio where escritorio_id = :P11_ESCRITORIO_ID and situacao <> 'CANCELADO'
        }
    )

    validation cnpj-valido (
        name: CNPJ válido
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return pkg_ecloud_util.cnpj_valido(:P11_CNPJ);
                ```
        }
        error {
            errorMessage: CNPJ inválido: confira os dígitos verificadores.
            associatedItem: @P11_CNPJ
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation municipio-da-uf (
        name: Município pertence à UF
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return pkg_ecloud_util.municipio_valido(:P11_UF, to_number(:P11_MUNICIPIO_IBGE));
                ```
        }
        error {
            errorMessage: O município informado não pertence à UF.
            associatedItem: @P11_MUNICIPIO_IBGE
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancelar diálogo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @escritorio
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3315905330
        }
    )

    process process-form (
        name: Gravar formulário
        type: formAutoRowProcessing
        formRegion: @escritorio
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4832436672
        }
    )

    process iniciar-assinatura (
        name: Iniciar assinatura
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    if :P11_PLANO_INICIAR is null then
                        raise_application_error(-20163, 'Escolha o plano da assinatura.');
                    end if;
                    l_id := pkg_ecloud_assinatura.iniciar(to_number(:P11_ESCRITORIO_ID), to_number(:P11_PLANO_INICIAR));
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1111200001
        }
        successMessage {
            successMessage: Assinatura iniciada: o escritório está em teste.
        }
        serverSideCondition {
            whenButtonPressed: @iniciar
        }
    )

    process liberar-acesso (
        name: Liberar acesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_ecloud_assinatura.liberar_acesso(
                    p_escritorio_id => to_number(:P11_ESCRITORIO_ID),
                    p_ate           => to_date(:P11_LIBERAR_ATE, 'DD/MM/YYYY'));
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1111200002
        }
        successMessage {
            successMessage: Acesso liberado.
        }
        serverSideCondition {
            whenButtonPressed: @liberar
        }
    )

    process cancelar-escritorio (
        name: Cancelar escritório
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_ecloud_assinatura.cancelar(to_number(:P11_ESCRITORIO_ID), 'Cancelado pela plataforma');
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1111200003
        }
        successMessage {
            successMessage: Escritório cancelado.
        }
        serverSideCondition {
            whenButtonPressed: @cancelar-escritorio
        }
    )

    branch assinatura (
        name: Voltar ao escritório
        execution {
            sequence: 10
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 11
                items: {
                    P11_ESCRITORIO_ID: &P11_ESCRITORIO_ID.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: INICIAR,LIBERAR,CANCELAR_ESCRITORIO
        }
    )

    process close-dialog (
        name: Fechar diálogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 3096399284
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)

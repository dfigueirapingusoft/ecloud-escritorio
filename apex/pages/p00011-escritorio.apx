page 11 (
    name: Escritório
    alias: ESCRITORIO
    title: Escritório
    pageGroup: @administracao
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    security {
        authorizationScheme: @admin-plataforma
    }

    region buttons (
        name: Botões
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region escritorio (
        name: Escritório
        type: form
        source {
            location: localDatabase
            tableName: ESCRITORIO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
    )

    pageItem P11_ESCRITORIO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @escritorio
            slot: regionBody
        }
        source {
            formRegion: @escritorio
            column: ESCRITORIO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_CNPJ (
        type: textField
        label {
            label: CNPJ
            alignment: right
        }
        layout {
            sequence: 20
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 18
        }
        source {
            formRegion: @escritorio
            column: CNPJ
            dataType: varchar2
        }
        help {
            inlineHelpText: Numérico ou alfanumérico; a máscara é opcional.
        }
    )

    pageItem P11_RAZAO_SOCIAL (
        type: textField
        label {
            label: Razão social
            alignment: right
        }
        layout {
            sequence: 30
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
        source {
            formRegion: @escritorio
            column: RAZAO_SOCIAL
            dataType: varchar2
        }
    )

    pageItem P11_NOME_FANTASIA (
        type: textField
        label {
            label: Nome fantasia
            alignment: right
        }
        layout {
            sequence: 40
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 150
        }
        source {
            formRegion: @escritorio
            column: NOME_FANTASIA
            dataType: varchar2
        }
    )

    pageItem P11_UF (
        type: selectList
        label {
            label: UF
            alignment: right
        }
        layout {
            sequence: 50
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @ufs
            displayNullValue: true
            nullDisplayValue: - Selecione -
        }
        source {
            formRegion: @escritorio
            column: UF
            dataType: varchar2
        }
    )

    pageItem P11_MUNICIPIO_IBGE (
        type: popupLov
        label {
            label: Município (IBGE)
            alignment: right
        }
        layout {
            sequence: 60
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome || ' (' || codigo || ')' d, codigo r
                  from rtc_da_municipio
                 where sigla_uf = :P11_UF
                 order by nome
                ```
        }
        source {
            formRegion: @escritorio
            column: MUNICIPIO_IBGE
            dataType: number
        }
        cascadingLov {
            parentItems: P11_UF
        }
    )

    pageItem P11_EMAIL (
        type: textField
        label {
            label: E-mail
            alignment: right
        }
        layout {
            sequence: 70
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @escritorio
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P11_TELEFONE (
        type: textField
        label {
            label: Telefone
            alignment: right
        }
        layout {
            sequence: 80
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @escritorio
            column: TELEFONE
            dataType: varchar2
        }
    )

    pageItem P11_ATIVO (
        type: switch
        label {
            label: Ativo
            alignment: right
        }
        layout {
            sequence: 90
            region: @escritorio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            useDefaults: false
            onValue: S
            offValue: N
        }
        source {
            formRegion: @escritorio
            column: ATIVO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: S
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ESCRITORIO_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_ESCRITORIO_ID
        }
    )

    validation cnpj-valido (
        name: CNPJ válido
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return pkg_ecloud_util.cnpj_valido(:P11_CNPJ);
                ```
        }
        error {
            errorMessage: CNPJ inválido: confira os dígitos verificadores.
            associatedItem: @P11_CNPJ
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation municipio-da-uf (
        name: Município pertence à UF
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return pkg_ecloud_util.municipio_valido(:P11_UF, to_number(:P11_MUNICIPIO_IBGE));
                ```
        }
        error {
            errorMessage: O município informado não pertence à UF.
            associatedItem: @P11_MUNICIPIO_IBGE
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancelar diálogo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @escritorio
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3315905330
        }
    )

    process process-form (
        name: Gravar formulário
        type: formAutoRowProcessing
        formRegion: @escritorio
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4832436672
        }
    )

    process close-dialog (
        name: Fechar diálogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 3096399284
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)

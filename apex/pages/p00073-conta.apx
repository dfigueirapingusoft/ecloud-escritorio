page 73 (
    name: Conta bancária
    alias: CONTA
    title: Conta bancária
    pageGroup: @rural
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
        width: 720
    }
    region buttons (
        name: Botões
        type: staticContent
        layout {
            sequence: 90
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region conta (
        name: Conta
        type: form
        source {
            location: localDatabase
            tableName: CONTA_BANCARIA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P73_CONTA_ID (
        type: hidden
        layout {
            sequence: 1
            region: @conta
            slot: regionBody
        }
        source {
            formRegion: @conta
            column: CONTA_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P73_CLIENTE_ID (
        type: hidden
        layout {
            sequence: 2
            region: @conta
            slot: regionBody
        }
        source {
            formRegion: @conta
            column: CLIENTE_ID
            dataType: number
        }
        default {
            type: item
            item: F_PRODUTOR_ID
        }
    )

    pageItem P73_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: right
        }
        layout {
            sequence: 20
            region: @conta
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @conta
            column: TIPO
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @tipo-conta
            displayNullValue: false
        }
        default {
            type: static
            staticValue: CORRENTE
        }
    )

    pageItem P73_COD_CONTA (
        type: numberField
        label {
            label: Código no LCDPR (001 a 998; caixa = 000)
            alignment: right
        }
        layout {
            sequence: 30
            region: @conta
            slot: regionBody
            startNewRow: false
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @conta
            column: COD_CONTA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: pkg_rural_cadastro.proximo_cod_conta(:P73_CLIENTE_ID)
        }
    )

    pageItem P73_APELIDO (
        type: textField
        label {
            label: Apelido
            alignment: right
        }
        layout {
            sequence: 40
            region: @conta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 60
        }
        source {
            formRegion: @conta
            column: APELIDO
            dataType: varchar2
        }
    )

    pageItem P73_BANCO_CODIGO (
        type: textField
        label {
            label: Código do banco (3 dígitos)
            alignment: right
        }
        layout {
            sequence: 50
            region: @conta
            slot: regionBody
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 3
        }
        source {
            formRegion: @conta
            column: BANCO_CODIGO
            dataType: varchar2
        }
        help {
            inlineHelpText: Obrigatório para conta bancária.
        }
    )

    pageItem P73_BANCO_NOME (
        type: textField
        label {
            label: Nome do banco
            alignment: right
        }
        layout {
            sequence: 60
            region: @conta
            slot: regionBody
            startNewRow: false
            columnSpan: 8
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @conta
            column: BANCO_NOME
            dataType: varchar2
        }
    )

    pageItem P73_AGENCIA (
        type: textField
        label {
            label: Agência (sem dígito)
            alignment: right
        }
        layout {
            sequence: 70
            region: @conta
            slot: regionBody
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 6
        }
        source {
            formRegion: @conta
            column: AGENCIA
            dataType: varchar2
        }
    )

    pageItem P73_CONTA_NUMERO (
        type: textField
        label {
            label: Conta (com dígito)
            alignment: right
        }
        layout {
            sequence: 80
            region: @conta
            slot: regionBody
            startNewRow: false
            columnSpan: 8
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @conta
            column: CONTA_NUMERO
            dataType: varchar2
        }
    )

    pageItem P73_SALDO_INICIAL (
        type: numberField
        label {
            label: Saldo inicial
            alignment: right
        }
        layout {
            sequence: 90
            region: @conta
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @conta
            column: SALDO_INICIAL
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P73_DATA_SALDO_INICIAL (
        type: datePicker
        label {
            label: Data do saldo inicial
            alignment: right
        }
        layout {
            sequence: 100
            region: @conta
            slot: regionBody
            startNewRow: false
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @conta
            column: DATA_SALDO_INICIAL
            dataType: date
        }
        default {
            type: expression
            plsqlExpression: trunc(current_date, 'YYYY')
        }
    )

    pageItem P73_LAYOUT_CSV_ID (
        type: selectList
        label {
            label: Layout padrão para extrato CSV
            alignment: right
        }
        layout {
            sequence: 110
            region: @conta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @conta
            column: LAYOUT_CSV_ID
            dataType: number
        }
        lov {
            type: sharedComponent
            lov: @layouts-csv
            displayNullValue: true
            nullDisplayValue: - Nenhum -
        }
    )

    pageItem P73_ATIVO (
        type: switch
        label {
            label: Ativa
            alignment: right
        }
        layout {
            sequence: 120
            region: @conta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            useDefaults: false
            onValue: S
            offValue: N
        }
        source {
            formRegion: @conta
            column: ATIVO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: S
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P73_CONTA_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P73_CONTA_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P73_CONTA_ID
        }
        security {
            authorizationScheme: @contador-ou-administrador
        }
    )

    validation codigo (
        name: Código da conta
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return :P73_TIPO = 'CAIXA' or to_number(:P73_COD_CONTA) between 1 and 998;
        }
        error {
            errorMessage: Conta bancária usa código de 001 a 998 (000 é o caixa e 999 é reservado).
            associatedItem: @P73_COD_CONTA
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation dados-bancarios (
        name: Dados bancários
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return :P73_TIPO = 'CAIXA'
                    or (    regexp_like(:P73_BANCO_CODIGO, '^[0-9]{3}$')
                        and :P73_BANCO_NOME is not null
                        and regexp_like(regexp_replace(:P73_AGENCIA, '[^0-9]', ''), '^[0-9]{1,4}$')
                        and regexp_like(regexp_replace(:P73_CONTA_NUMERO, '[^0-9]', ''), '^[0-9]{1,16}$'));
                ```
        }
        error {
            errorMessage: Informe banco (3 dígitos), nome do banco, agência (até 4 dígitos, sem DV) e conta (até 16 dígitos, com DV).
            associatedItem: @P73_BANCO_CODIGO
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancelar diálogo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process initialize-form (
        name: Inicializar formulário
        type: formInitialization
        formRegion: @conta
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8804567550
        }
    )

    process ajustar-caixa (
        name: Caixa usa o código 000
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P73_TIPO = 'CAIXA' then
                    :P73_COD_CONTA := 0;
                end if;
                ```
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 9479345689
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process process-form (
        name: Gravar conta
        type: formAutoRowProcessing
        formRegion: @conta
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4105088572
        }
    )

    process close-dialog (
        name: Fechar diálogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9375533279
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )
)

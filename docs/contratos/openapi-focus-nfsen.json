      "maximum": 49999
     },
     "numero_dps": {
      "type": "integer",
      "description": "Número da DPS. Integer[15]."
     },
     "data_competencia": {
      "type": "string",
      "description": "Data de competência da prestação (AAAA-MM-DD).",
